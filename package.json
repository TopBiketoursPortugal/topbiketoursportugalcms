{
  "name": "topbiketoursportugal-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "pnpm --filter topbiketoursportugal dev",
    "dev:walking": "pnpm --filter topwalkingtoursportugal dev",
    "dev:mobile": "pnpm --filter topbiketoursportugal-mobile start",
    "build": "pnpm --filter topbiketoursportugal build",
    "build:walking": "pnpm --filter topwalkingtoursportugal build",
    "build:all": "pnpm -r --filter './apps/*' --filter '!topbiketoursportugal-mobile' build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "codegen": "pnpm -r --filter './apps/*' --filter '!topbiketoursportugal-mobile' codegen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.11.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-astro-organize-imports": "0.4.12",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": "^22.x"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
