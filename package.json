{
  "name": "astro-top-bike-tours-portugal-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "mkcert create-ca && mkcert create-cert",
    "dev": "astro dev",
    "server": "caddy run --config ./caddyfile",
    "start": "pnpm build --site:https://localhost && pnpm server",
    "start:prod": "pnpm build:prod && pnpm server",
    "build": "astro build && pnpm seo:check && pnpm seo:audit",
    "build:prod": "astro build --site:https://localhost",
    "build:prod:extra": "astro build && pnpm jampack",
    "jampack": "pnpm dlx --allow-build=@swc/core --allow-build=esbuild --allow-build=sharp @divriots/jampack ./dist",
    "preview": "astro preview",
    "astro": "astro",
    "codegen": "astro sync && astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:build": "lychee --offline ./dist",
    "prepare": "lefthook install",
    "mdx-clone": "node ./tools/mdx-clone.mjs",
    "deps": "pnpx npm-check-updates -i",
    "icons:update": "pwsh ./tools/update-icons.ps1",
    "seo:urls": "node tools/seo/url-history.mjs",
    "seo:check": "node tools/seo/check-urls.mjs",
    "seo:audit": "node tools/seo/audit-dist.mjs"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "catalog:",
    "@astrojs/markdown-satteri": "catalog:",
