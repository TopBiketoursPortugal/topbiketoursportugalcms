{
  "name": "astro-top-bike-tours-portugal-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "//install": "pnpm exec husky init && echo pnpm lint-staged > .husky/pre-commit",
    "postinstall": "mkcert create-ca && mkcert create-cert",
    "dev": "astro dev",
    "server": "caddy file-server -r ./dist -d localhost -b",
    "start": "pnpm build --site:https://localhost && pnpm server",
    "start:prod": "pnpm build:prod && pnpm server",
    "build": "astro build",
    "build:prod": "astro build --site:https://localhost && pnpm dlx @divriots/jampack ./dist",
    "build:prod:extra": "astro build && pnpm dlx @divriots/jampack ./dist",
    "preview": "astro preview",
    "astro": "astro",
    "codegen": "astro sync && astro check",
    "lint": "pnpm eslint **/*.*",
    "check:build": "lychee --offline ./dist",
    "generate:types": "pnpm json2ts platforms.schema.json > platforms.d.ts",
    "generate": "pnpm dlx @bookshop/generate",
    "json2ts": "json2ts",
    "prepare": "husky",
    "mdx-clone": "node ./tools/mdx-clone.mjs"
  },
