    "@vite-pwa/assets-generator": "catalog:",
    "astro": "catalog:",
    "astro-pagefind": "catalog:",
    "clsx": "catalog:",
    "embla-carousel": "catalog:",
    "embla-carousel-auto-scroll": "catalog:",
    "embla-carousel-autoplay": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
