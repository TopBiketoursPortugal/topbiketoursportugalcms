---
import type { BreadcrumbItem } from 'utils/breadcrumbs';

type Props = { items: BreadcrumbItem[] };

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="px-4 py-3 text-sm">
  <ol
    class="flex flex-wrap items-center gap-1 text-gray-500 dark:text-gray-400"
  >
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && (
            <span class="mx-1" aria-hidden="true">
              /
            </span>
          )}
          {index < items.length - 1 ? (
            <a
              href={item.url}
              class="hover:text-gray-900 hover:underline dark:hover:text-gray-200"
            >
              {item.name}
            </a>
          ) : (
            <span class="text-gray-900 dark:text-gray-100" aria-current="page">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
