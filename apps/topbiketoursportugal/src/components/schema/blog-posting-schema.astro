---
import { getCollection } from 'astro:content';
import SiteData from 'src/../data/site.json';
import type { LanguageCodes } from 'src/schemas/language';
import { resolveSchemaImage } from 'utils/schema-image';
import { resolveSchemaAuthor, parseByline } from 'utils/schema-author';
import { getTeamMemberPath } from 'utils/permalinks';
import { lastmodFor } from '@ttp/seo-tools/lib/lastmod.mjs';

type Props = {
  title: string;
  date: string | Date;
  author?: string | null;
  image?: string;
  wordCount?: number;
  language: LanguageCodes;
  url: string;
};

const { title, date, author, image, wordCount, language, url } = Astro.props;
const site = SiteData[language];
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const imageUrl = await resolveSchemaImage(image, Astro.site);

// One organisation, not one per locale. `SiteData.pt.site.url` carries the
// /pt/ prefix, so deriving the id from the current language published two
// competing `#organization` entities and split the brand across them.
const organisationId = `${SiteData.en.site.url.replace(/\/$/, '')}/#organization`;

// If the byline names someone with a team page, point at it — the pages exist
// and ranked, but nothing linked them to the posts they wrote.
const teamMembers = await getCollection(
  'team',
  (member) => member.data.language === language
);
const knownNames = teamMembers.map((member) => member.data.title ?? '');
const bylineName = author ? parseByline(author, knownNames).name : null;
const teamMatch = bylineName
  ? teamMembers.find(
      (member) =>
        (member.data.title ?? '').trim().toLowerCase() ===
        bylineName.trim().toLowerCase()
    )
  : undefined;
const teamUrl = teamMatch
  ? `${baseUrl}${getTeamMemberPath(teamMatch.data.title ?? '', language)}`
  : undefined;

const publishedAt = new Date(date);

// Freshness, from the commit that last touched the post — the same signal the
// sitemap's `lastmod` uses, so the two cannot disagree. Emitted only when it is
// genuinely later than the publish date: several posts are backdated, and a
// `dateModified` before `datePublished` is worse than none at all.
const modifiedRaw = lastmodFor(`${baseUrl}${url}`);
const modifiedAt = modifiedRaw ? new Date(modifiedRaw) : null;
const dateModified =
  modifiedAt && modifiedAt > publishedAt ? modifiedAt.toISOString() : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'datePublished': publishedAt.toISOString(),
  ...(dateModified ? { dateModified } : {}),
  'url': `${baseUrl}${url}`,
  // Ties the article node to the page it lives on rather than leaving Google to
  // infer it — the pairing Google's own Article guidance asks for.
  'mainEntityOfPage': { '@type': 'WebPage', '@id': `${baseUrl}${url}` },
  'author': resolveSchemaAuthor(author, organisationId, teamUrl, knownNames),
  ...(imageUrl ? { image: imageUrl } : {}),
  ...(wordCount ? { wordCount } : {}),
  'publisher': {
    '@type': 'Organization',
    '@id': organisationId,
    'name': site.site.name
  }
};
---

<script
  is:inline
  async
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
