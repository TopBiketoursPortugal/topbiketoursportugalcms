---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import { getRiderLevelPath } from 'utils/permalinks';
import { getTagIconClass } from 'src/utils/tag-icon-safelist';

type Props = {
  level: CollectionEntry<'tourRiderLevels'>;
  language: LanguageCodes;
  size?: 'sm' | 'md';
};

const { level, language, size = 'sm' } = Astro.props;
const name = level.data.name ?? level.data.title;
const href = getRiderLevelPath(level, language);
const iconClass = getTagIconClass(level.data.icon);

const sizeClasses =
  size === 'sm' ? 'px-2 py-0.5 text-xs gap-1' : 'px-3 py-1 text-sm gap-1.5';

const iconSize = size === 'sm' ? 'h-3.5 w-3.5' : 'h-4 w-4';
---

<a
  href={href}
  class:list={[
    'rider-level-badge inline-flex items-center rounded-full border border-blue-200 bg-blue-50 text-blue-700 transition-colors hover:border-blue-400 hover:bg-blue-100 hover:text-blue-800 dark:border-blue-700 dark:bg-blue-900/30 dark:text-blue-300 dark:hover:border-blue-500 dark:hover:bg-blue-900/50 dark:hover:text-blue-200',
    sizeClasses
  ]}
>
  <i class:list={[iconClass, iconSize, 'shrink-0']} aria-hidden="true"></i>
  <span>{name}</span>
</a>
