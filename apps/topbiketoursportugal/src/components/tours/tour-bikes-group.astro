---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import BikesCard from 'src/components/page-sections/collection/bikes-card.astro';
import Heading from 'src/components/building-blocks/typography/heading.astro';
import { getBikeCategoryPath } from 'utils/permalinks';
import { getTagIconClass } from 'src/utils/tag-icon-safelist';

type Props = {
  category: CollectionEntry<'bikeCategories'>;
  bikes: CollectionEntry<'bikes'>[];
  language: LanguageCodes;
};

const { category, bikes, language } = Astro.props;
const iconClass = getTagIconClass(category.data.icon);
---

<div class="flex flex-col gap-4">
  <a
    href={getBikeCategoryPath(category, language)}
    class="hover:text-accent dark:hover:text-accent flex items-center gap-2 transition-colors"
  >
    <i
      class:list={[iconClass, 'text-accent dark:text-accent h-6 w-6']}
      aria-hidden="true"></i>
    <Heading as="h3">{category.data.name ?? category.data.title}</Heading>
  </a>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      bikes.map((bike) => (
        <BikesCard bike={bike} language={language} imageWidths={[400]} />
      ))
    }
  </div>
</div>
