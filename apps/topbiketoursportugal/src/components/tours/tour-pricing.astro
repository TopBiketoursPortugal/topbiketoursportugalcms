---
import type { TourPackageSchema } from 'src/schemas/tours';
import languages from 'src/../data/languages.json';
import type { LanguageCodes } from 'src/schemas/language';
import PricingColumn from 'src/components/building-blocks/pricing-table/pricing-column.astro';
import type { InferEntrySchema } from 'astro:content';
import TourBookNow from './tour-book-now.astro';
import { isAffirmative, isInclusionFlag } from 'utils/inclusion-flag';

type Props = {
  packages?: TourPackageSchema[];
  language?: LanguageCodes;
  tour?: InferEntrySchema<'tours'>;
  // 'pricing' = first table (shows price + book button);
  // 'matrix'  = seasons / add-ons tables (rows only, no price header).
  variant?: 'pricing' | 'matrix';
};

const {
  packages = [],
  language = 'en',
  tour,
  variant = 'pricing'
} = Astro.props;

const showPrice = variant === 'pricing';

const currency =
  (packages.length > 0 ? packages[0].price?.currency : null) ?? 'EUR';

const priceFormat = new Intl.NumberFormat(languages[language].locale, {
  style: 'currency',
  currency
});
---

<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    packages.map(
      ({ title, duration, popular, included = [], price = { price: 0 } }) => (
        <PricingColumn
          title={title}
          price={showPrice ? priceFormat.format(price?.price ?? 0) : ''}
          promo={
            showPrice && price?.promo ? priceFormat.format(price.promo) : ''
          }
          period={showPrice ? duration : ''}
          popular={popular}
          bestValue={price?.bestValue ?? false}
          showPrice={showPrice}
        >
          {showPrice && tour && (
            <div slot="action" class="mt-3 flex justify-center">
              <TourBookNow
                tour={tour}
                language={language}
                variant="column"
                buttonClass="mb-2 w-auto h-auto min-h-0 rounded-full px-4 py-1 text-sm font-semibold transition-colors bg-black text-white hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
              />
            </div>
          )}
          {(included ?? []).map((feature) => {
            const {
              description,
              title: featureTitle = '',
              info = ''
            } = feature;
            // The description text is the source of truth for the tick/cross.
            // The `included` boolean is kept in sync with it in the content
            // files, but it is NOT consulted here: the CMS structure defaults
            // it to `true` on every new row, so a "No"/"X" row with a stale
            // `included: true` used to render as a green check.
            const isBoolean = isInclusionFlag(description);
            const isYes = isAffirmative(description);
            return (
              <div class="flex items-center justify-between gap-3 border-b border-gray-100 py-2 text-sm last:border-0 dark:border-gray-800">
                <span class="text-gray-600 dark:text-gray-400">
                  {featureTitle}
                </span>
                <span
                  class="flex shrink-0 items-center gap-1 text-right font-medium text-gray-900 dark:text-gray-100"
                  title={info}
                >
                  {isBoolean ? (
                    isYes ? (
                      <i
                        class="icon-[ph--check-circle-fill] h-5 w-5 text-green-600"
                        title="Included in price."
                        aria-label="Included"
                      />
                    ) : (
                      <i
                        class="icon-[ph--x-circle-fill] h-5 w-5 text-red-500"
                        title="Not included in price."
                        aria-label="Not included"
                      />
                    )
                  ) : (
                    description
                  )}
                  {info ? (
                    <i class="icon-[ph--info-light] h-4 w-4 text-gray-400" />
                  ) : null}
                </span>
              </div>
            );
          })}
        </PricingColumn>
      )
    )
  }
</div>
