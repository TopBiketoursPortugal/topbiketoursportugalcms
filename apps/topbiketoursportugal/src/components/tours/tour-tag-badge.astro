---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import { getTourTagPath } from 'utils/permalinks';
import { getTagIconClass } from 'src/utils/tag-icon-safelist';

type Props = {
  tag: CollectionEntry<'tourTags'>;
  language: LanguageCodes;
  size?: 'sm' | 'md';
};

const { tag, language, size = 'sm' } = Astro.props;
const name = tag.data.name ?? tag.data.title;
const href = getTourTagPath(tag, language);
const iconClass = getTagIconClass(tag.data.icon);

const sizeClasses =
  size === 'sm' ? 'px-2 py-0.5 text-xs gap-1' : 'px-3 py-1 text-sm gap-1.5';

const iconSize = size === 'sm' ? 'h-3.5 w-3.5' : 'h-4 w-4';
---

<a
  href={href}
  class:list={[
    'tour-tag-badge inline-flex items-center rounded-full border border-gray-200 bg-gray-50 text-gray-700 transition-colors hover:border-green-300 hover:bg-green-50 hover:text-green-700 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-green-600 dark:hover:bg-green-900/30 dark:hover:text-green-400',
    sizeClasses
  ]}
>
  <i class:list={[iconClass, iconSize, 'shrink-0']} aria-hidden="true"></i>
  <span>{name}</span>
</a>
