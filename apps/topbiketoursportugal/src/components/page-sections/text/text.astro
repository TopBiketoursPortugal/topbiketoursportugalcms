---
import markdownit from 'markdown-it'; // or your preferred Markdown component
import markdownItExternalLinks from 'markdown-it-external-links';

import { tv, type VariantProps } from 'tailwind-variants';
import Prose from 'src/components/building-blocks/typography/prose.astro';
import { externalLinksConfig } from 'utils/external-links';

export type TextProps = {
  text: string;
  tailwind?: string;
  style: VariantProps<typeof textVariants>;
};

type Props = TextProps;

const textVariants = tv({
  // No `base` here: tailwind-variants ignores a root `base` once `slots` is
  // declared, so the old value (which included `break-all`, a mid-word
  // character break) never reached the DOM. Slot defaults live on the slots.
  variants: {
    padding: {
      none: { container: 'p-0' },
      loose: { container: 'px-6 md:px-8' },
      normal: { container: 'px-4 md:px-5' },
      tight: { container: 'px-2 md:px-4' }
    },
    // `full` is authored in the CMS (data-driven pages set it) but had no
    // matching variant, so it resolved to no class at all: the block spanned
    // the viewport and Prose's own `max-w-full` removed the typographic
    // measure with it, giving ~180 characters per line on a wide monitor.
    // It now means what it reads like — a full-bleed band with the copy still
    // held to a readable measure inside it.
    container: {
      fluid: { container: 'max-w-none' },
      full: { container: 'max-w-none', text: 'mx-auto w-full max-w-[72ch]' },
      centered: { container: 'mx-auto max-w-7xl' }
    },
    align: {
      leading: { text: 'flex items-start text-left' },
      trailing: { text: 'flex items-end text-right' },
      centered: { text: 'flex items-center text-center' }
    }
  },
  slots: {
    container: '',
    text: ''
  },
  defaultVariants: {
    padding: 'normal',
    container: 'centered',
    align: 'leading'
  }
});

const { text, style } = Astro.props;
const { padding, align, container } = style;

const md = markdownit({ html: true });
md.use(markdownItExternalLinks, externalLinksConfig);
const textHTML = md.render(text ?? '');
const { container: containerStyle, text: textStyle } = textVariants({
  padding,
  container,
  align
});
---

<div class={containerStyle()}>
  <Prose class={textStyle()} set:html={textHTML} />
</div>
