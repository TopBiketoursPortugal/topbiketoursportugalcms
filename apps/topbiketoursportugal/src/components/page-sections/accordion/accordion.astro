---
import {
  Container,
  type ContainerProps
} from 'src/components/building-blocks/container';
import Prose from 'src/components/building-blocks/typography/prose.astro';
import AccordionItem from './accordion-item.astro';

export type AccordionItemProps = {
  header?: { text?: string };
  content?: string;
};

export type AccordionProps = {
  container?: ContainerProps['size'];
  padding?: ContainerProps['padding'];
  expansionType?: 'plus' | 'arrow';
  type?: 'faq';
  items?: AccordionItemProps[];
};

type Props = AccordionProps;

function markdownToText(md: string) {
  return md
    .replace(/!\[.*?\]\(.*?\)/g, '') // remove images
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // remove links but keep text
    .replace(/[*_~`>#-]/g, '') // remove common markdown chars
    .replace(/\n+/g, ' ') // collapse new lines
    .trim();
}

const {
  items = [],
  container = 'full',
  padding = 'none',
  type = ''
} = Astro.props;
const faqSchema =
  type === 'faq'
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': items.map((i) => ({
          '@type': 'Question',
          'name': markdownToText(i.header?.text ?? ''),
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': markdownToText(i.content ?? '')
          }
        }))
      }
    : '';
---

{
  type === 'faq' && (
    <script
      is:inline
      async
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  )
}
<Container size={container} padding={padding}>
  <div
    role="group"
    aria-label="Accordion"
    class="accordion flex flex-col gap-2"
  >
    <slot>
      {
        items.map(({ header, content }) => (
          <AccordionItem open class="border-none">
            <div slot="header" class="flex w-full items-center gap-4">
              <div class="box-content flex border-collapse items-center justify-center border-gray-600 bg-slate-100 p-4 hover:bg-slate-400">
                <svg
                  class="h-5 w-5 transition-transform duration-300 ease-in-out"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    class="vertical-line group-open:hidden"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16"
                  />
                  <path
                    class="horizontal-line"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 12h16"
                  />
                </svg>
              </div>
              <Prose markdown={header?.text} />
            </div>
            <div class="pl-4">
              <Container size="full" padding={padding}>
                <Prose markdown={content} />
              </Container>
            </div>
          </AccordionItem>
        ))
      }
    </slot>
  </div>
</Container>
