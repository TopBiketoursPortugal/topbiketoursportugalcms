# Copy to .env and fill in — see src/lib/mapStyle.ts for why nothing ships
# hardcoded here. Get a MapLibre-compatible style URL (with your API key
# already in the query string) from a provider whose terms allow offline
# downloading, e.g.:
#   MapTiler:    https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
#   Stadia Maps: https://tiles.stadiamaps.com/styles/outdoors.json?api_key=YOUR_KEY
EXPO_PUBLIC_MAP_STYLE_URL=

# Optional — only used by the "Recompute route" button when a rider goes
# off the planned path (src/lib/directions.ts). Everything else on the
# Route tab works with this unset; without it, Recompute just explains
# that it needs a key instead of failing silently. Free tier signup:
# https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_API_KEY=
