---
import ResponsiveImage from 'src/components/building-blocks/responsive-image/ResponsiveImage.astro';
import { t } from 'utils/i18n';
import Languages from 'src/../data/languages.json';
import type { LanguageCodes } from 'src/schemas/language';

type Props = {
  title: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
  duration?: string | null;
  difficulty?: number | null;
  minPrice: number;
  currency: string;
  language: LanguageCodes;
  index: number;
};

const {
  title,
  href,
  imageSrc,
  imageAlt,
  duration,
  difficulty,
  minPrice,
  currency,
  language,
  index
} = Astro.props;

const durationDays = duration ? Number(duration) : 0;
// Only packages reach this menu, so `1` is not expected — but the label picks
// itself rather than relying on that staying true.
const dayUnit =
  durationDays === 1
    ? ('Tour.Info.Duration.Unit.Day' as const)
    : ('Tour.Info.Duration.Unit.Days' as const);

const priceFormat = new Intl.NumberFormat(Languages[language].locale, {
  style: 'currency',
  currency: currency || 'EUR'
});
---

<a
  href={href}
  class="mega-menu-card group/card flex flex-col overflow-hidden rounded-lg bg-white shadow-sm transition-shadow hover:shadow-md dark:bg-slate-800"
  style={`--card-index: ${index}`}
>
  <div class="zoom-frame relative aspect-4/3">
    <ResponsiveImage
      src={imageSrc}
      alt={imageAlt}
      widths={[240, 360]}
      loading="lazy"
      aboveTheFold={false}
      class="h-full w-full object-cover"
      paralax={false}
    />
    {
      minPrice > 0 && (
        <span class="absolute right-2 bottom-2 rounded bg-black/60 px-2 py-0.5 text-xs font-semibold text-white backdrop-blur-sm">
          {t('Tour.Form.FromPrice', language)} {priceFormat.format(minPrice)}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 p-2.5">
    {
      /*
      Was an <h4>. The mega-menu renders fifteen of these in the site header,
      so every page's document outline opened with fifteen h4s before its own
      h1 — which is what a screen reader's heading navigation and any
      outline-based crawl see first. These are navigation labels, not document
      structure.
    */
    }
    <span
      class="line-clamp-2 text-sm leading-tight font-semibold text-slate-900 dark:text-slate-100"
    >
      {title}
    </span>
    {
      durationDays > 0 || (difficulty && difficulty > 0) ? (
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          {durationDays > 0 && (
            <span class="flex items-center gap-0.5">
              <i
                class="icon-[ph--clock-countdown-light] h-3.5 w-3.5"
                aria-hidden="true"
              />
              {duration} {t(dayUnit, language)}
            </span>
          )}
          {durationDays > 0 && difficulty && difficulty > 0 && (
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">
              |
            </span>
          )}
          {difficulty && difficulty > 0 && (
            <span class="flex items-center gap-0.5">
              <i
                class="icon-[ph--person-simple-walk-light] h-3.5 w-3.5"
                aria-hidden="true"
              />
              {difficulty}/5
            </span>
          )}
        </div>
      ) : null
    }
  </div>
</a>
