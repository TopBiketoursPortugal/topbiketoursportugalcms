---
import { t } from 'utils/i18n';
import SiteData from 'src/../data/site.json';
import ContactData from 'src/../data/contact.json';
import SocialData from 'src/../data/social.json';
import type { LanguageCodes } from 'src/schemas/language';
import { resolveSchemaImage } from 'utils/schema-image';

type Props = { language: LanguageCodes };

const { language } = Astro.props;
const site = SiteData[language];
const contact = ContactData[language];

const baseUrl = site.site.url.replace(/\/$/, '');

// The company is one entity in both languages. Deriving the `@id` from the
// current locale's base URL published `/#organization` on English pages and
// `/pt/#organization` on Portuguese ones, so Google was handed two businesses
// sharing a name, address and phone number. `url` still varies by locale —
// that is the localised homepage — but the identity does not.
const organisationId = `${SiteData.en.site.url.replace(/\/$/, '')}/#organization`;

// Both of these used to point at paths that 404 in production — `/logo.svg`
// was never in public/, and `/src/assets/...` is a source path that only
// exists at build time.
const imageUrl = await resolveSchemaImage(site.image.src, Astro.site);
const logoUrl = await resolveSchemaImage(
  '/src/assets/images/logo.png',
  Astro.site
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': organisationId,
  'name': site.site.name,
  'url': baseUrl,
  'description': t('Organization.Description', language),
  'telephone': contact.cellPhone,
  'email': contact.email,
  'logo': logoUrl,
  'image': imageUrl,
  'priceRange': '€€',
  'currenciesAccepted': 'EUR',
  'paymentAccepted': 'Credit Card, Bank Transfer',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': contact.address.street,
    'addressLocality': contact.address.city,
    'addressRegion': contact.address.state,
    'postalCode': contact.address.postalCode,
    'addressCountry': contact.address.country
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': parseFloat(contact.address.latitude),
    'longitude': parseFloat(contact.address.longitude)
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '09:00',
      'closes': '18:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': 'Saturday',
      'opens': '09:00',
      'closes': '13:00'
    }
  ],
  'sameAs': [
    SocialData.facebook.href,
    SocialData.instagram.href,
    SocialData.tripadvisor.href,
    SocialData.twitter.href
  ]
};
---

<script
  is:inline
  async
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
