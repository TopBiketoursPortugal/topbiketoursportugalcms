---
import type { CollectionEntry } from 'astro:content';
import PostSummary from './summary.astro';
type Props = {
  posts: CollectionEntry<'blog'>[];
};

const { posts } = Astro.props;
---

<div
  class="blog-grid justify-between gap-5 md:mt-16 md:grid md:grid-cols-2 lg:grid-cols-3"
>
  {posts.map((post) => <PostSummary {...post} />)}
</div>

<style>
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .blog-grid > :global(:nth-child(3n + 2)) {
      transition-delay: 0.1s;
    }
    .blog-grid > :global(:nth-child(3n + 3)) {
      transition-delay: 0.2s;
    }
  }
</style>
