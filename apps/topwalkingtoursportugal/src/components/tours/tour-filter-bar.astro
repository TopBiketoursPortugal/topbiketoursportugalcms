---
import type { LanguageCodes } from 'src/schemas/language';
import { t } from 'utils/i18n';

/**
 * `slug` is what appears in the URL; `id` is what the cards are tagged with.
 * A shared filter link reads `?region=douro` rather than
 * `?region=01cb4d5b-fac6-4adc-a890-0edf59873a1e` — which matters, because for
 * this audience sending the filtered view to the person they are planning the
 * trip with is the normal case, not an edge one.
 */
type FilterOption = { id: string; name: string; slug?: string | null };
type Props = {
  language: LanguageCodes;
  totalCount: number;
  showRegion?: boolean;
  showTag?: boolean;
  regions?: FilterOption[];
  tags?: FilterOption[];
};

const {
  language,
  totalCount,
  showRegion = false,
  showTag = false,
  regions = [],
  tags = []
} = Astro.props;

const resultCountTemplate = t('Tours.Filter.ResultCount', language);
const availableCountTemplate = t('Tours.Collection.ResultCount', language);
const clearLabel = t('Tours.Filter.Clear', language);
const searchPlaceholder = t('Tours.Filter.SearchPlaceholder', language);
const noResultsText = t('Tours.Filter.NoResults', language);
const filtersLabel = t('Tours.Filter.Show', language);
const filtersCountTemplate = t('Tours.Filter.ShowCount', language);
const applyTemplate = t('Tours.Filter.Apply', language);
const closeLabel = t('Tours.Filter.Close', language);

const selectClass =
  'rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm outline-none transition-colors focus:border-accent focus:ring-1 focus:ring-accent dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:focus:border-accent dark:focus:ring-accent';

const facets = [
  {
    key: 'region',
    show: showRegion && regions.length > 0,
    label: t('Tours.Filter.Region', language),
    options: regions
  },
  {
    key: 'tag',
    show: showTag && tags.length > 0,
    label: t('Tours.Filter.Tag', language),
    options: tags
  }
].filter((f) => f.show);

const sortOptions = [
  { value: '', label: t('Tours.Sort.Recommended', language) },
  { value: 'price-asc', label: t('Tours.Sort.PriceAsc', language) },
  { value: 'price-desc', label: t('Tours.Sort.PriceDesc', language) },
  { value: 'duration-asc', label: t('Tours.Sort.DurationAsc', language) },
  { value: 'duration-desc', label: t('Tours.Sort.DurationDesc', language) },
  { value: 'difficulty-asc', label: t('Tours.Sort.DifficultyAsc', language) },
  { value: 'rating-desc', label: t('Tours.Sort.RatingDesc', language) }
];
---

<div
  data-filter-bar
  data-total-count={totalCount}
  data-result-template={resultCountTemplate}
  data-available-template={availableCountTemplate}
  data-filters-label={filtersLabel}
  data-filters-count-template={filtersCountTemplate}
  data-apply-template={applyTemplate}
  class="filter-bar relative sticky top-16 z-30 border-b border-gray-200 px-4 py-3 sm:px-6 dark:border-gray-700"
>
  {
    /*
    The translucent blur lives on its own layer rather than on the bar.
    `backdrop-filter` makes an element the containing block for any `fixed`
    descendant, so with the blur on the bar itself the mobile filter sheet
    below anchored to the bar's 90px-tall box and rendered off the top of the
    screen instead of at the bottom of the viewport.
  */
  }
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-white/85 backdrop-blur-md dark:bg-gray-900/85"
  ></span>
  <div class="relative flex flex-wrap items-center gap-3">
    <!-- Search input -->
    <div class="relative min-w-50 flex-1">
      <i
        class="icon-[ph--magnifying-glass] absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
        aria-hidden="true"></i>
      <input
        type="search"
        data-filter-search
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        class="focus:border-accent focus:ring-accent dark:focus:border-accent dark:focus:ring-accent w-full rounded-lg border border-gray-300 bg-white py-2 pr-3 pl-9 text-sm transition-colors outline-none focus:ring-1 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100"
      />
    </div>

    {
      /*
      Below `lg` the four facet selects wrapped into a three-row block ~200px
      tall — and the bar is sticky, so it held a quarter of a phone screen for
      the entire page. They now live in a bottom sheet behind this button. At
      `lg` the sheet wrapper becomes `display: contents` and the same selects
      rejoin this row, so there is only ever one set of controls and one source
      of state.
    */
    }
    {
      facets.length > 0 && (
        <button
          type="button"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="tour-filter-facets"
          class="flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium transition-colors hover:bg-gray-50 lg:hidden dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700"
        >
          <i class="icon-[ph--sliders-horizontal] h-4 w-4" aria-hidden="true" />
          <span data-filter-toggle-label>{filtersLabel}</span>
        </button>
      )
    }

    <label class="sr-only" for="tour-sort">
      {t('Tours.Filter.Sort', language)}
    </label>
    <select id="tour-sort" data-filter-sort class={selectClass}>
      {sortOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>

    <div
      id="tour-filter-facets"
      data-filter-facets
      class="filter-facets"
      aria-label={t('Tours.Filter.Label', language)}
    >
      <div class="filter-sheet-head lg:hidden">
        <span class="font-heading text-base font-bold">{filtersLabel}</span>
        <button
          type="button"
          data-filter-close
          class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
          aria-label={closeLabel}
        >
          <i class="icon-[ph--x] h-5 w-5" aria-hidden="true"></i>
        </button>
      </div>

      <div class="filter-sheet-body">
        {
          facets.map((facet) => (
            <select
              data-filter-select={facet.key}
              data-filter-label={facet.label}
              aria-label={facet.label}
              class={`${selectClass} filter-facet-select`}
            >
              <option value="">{facet.label}</option>
              {facet.options.map((o) => (
                <option value={o.id} data-slug={o.slug ?? o.id}>
                  {o.name}
                </option>
              ))}
            </select>
          ))
        }
      </div>

      <div class="filter-sheet-foot lg:hidden">
        <button
          type="button"
          data-filter-apply
          class="bg-primary w-full rounded-lg px-4 py-3 text-sm font-semibold text-white transition-colors hover:brightness-110"
        ></button>
      </div>
    </div>

    <!-- Result count. Always on: a bare grid gives no sense of how much is
         here, and the number only appearing once you filter reads as an error
         state rather than a summary. -->
    <span
      data-filter-count
      class="text-sm text-gray-500 tabular-nums dark:text-gray-400"></span>

    <button
      data-filter-clear
      class="hidden rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-600 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
    >
      {clearLabel}
    </button>
  </div>

  <!-- Active filters as removable chips: a filtered view should say what it is
       filtered to without the reader having to read four <select> labels. -->
  <div
    data-filter-chips
    class="relative mt-2 hidden flex-wrap items-center gap-2"
  >
  </div>

  <!-- Empty state -->
  <p
    data-filter-empty
    class="relative mt-3 hidden text-center text-sm text-gray-500 dark:text-gray-400"
  >
    {noResultsText}
  </p>
</div>

<div
  data-filter-backdrop
  class="fixed inset-0 z-40 hidden bg-black/40 backdrop-blur-[2px] lg:hidden"
  hidden
>
</div>

<style>
  /*
   * One set of controls, two presentations. At `lg` the wrapper dissolves and
   * its children become direct flex items of the toolbar row; below `lg` it is
   * a bottom sheet. `display: contents` is what makes this possible without
   * rendering the selects twice and having to keep two sets of state in sync.
   */
  @media (min-width: 1024px) {
    .filter-facets {
      display: contents;
    }
    .filter-sheet-head,
    .filter-sheet-foot {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .filter-facets {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 50;
      display: flex;
      max-height: 80vh;
      flex-direction: column;
      gap: 0;
      overflow: hidden;
      border-top-left-radius: 1rem;
      border-top-right-radius: 1rem;
      background: white;
      box-shadow: 0 -8px 40px rgb(15 35 25 / 0.25);
      transform: translateY(100%);
      visibility: hidden;
    }

    :global(.dark) .filter-facets {
      background: #111827;
    }

    @media (prefers-reduced-motion: no-preference) {
      .filter-facets {
        transition:
          transform 280ms var(--reveal-ease),
          visibility 280ms;
      }
    }

    .filter-facets[data-open] {
      transform: none;
      visibility: visible;
    }

    .filter-sheet-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgb(0 0 0 / 0.08);
      padding: 0.75rem 1rem;
    }

    .filter-sheet-body {
      display: grid;
      gap: 0.75rem;
      overflow-y: auto;
      padding: 1rem;
      /* Keep the sheet clear of the home indicator on iOS. */
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }

    .filter-facet-select {
      width: 100%;
      /* 44px: the selects were 36px tall, under every touch-target floor. */
      min-height: 44px;
    }

    .filter-sheet-foot {
      border-top: 1px solid rgb(0 0 0 / 0.08);
      padding: 0.75rem 1rem;
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  type SortKey =
    | ''
    | 'price-asc'
    | 'price-desc'
    | 'duration-asc'
    | 'duration-desc'
    | 'difficulty-asc'
    | 'rating-desc';

  // Short, stable query keys. These end up in URLs people paste to the person
  // they are planning the trip with, so they are part of the public surface.
  const PARAM = {
    q: 'q',
    region: 'region',
    tag: 'category',
    sort: 'sort'
  } as const;

  function initTourFilter() {
    const bars = document.querySelectorAll<HTMLElement>('[data-filter-bar]');

    bars.forEach((bar, barIndex) => {
      if (bar.dataset.filterInitialized) return;
      bar.dataset.filterInitialized = 'true';

      /*
       * A page can carry more than one collection block (package tours and day
       * tours on /hiking-tours-portugal). Two elements both pinned at the same
       * `top` fight for the same strip of screen, so only the first bar on a
       * page stays sticky; the rest sit in flow under their own heading.
       */
      if (barIndex > 0) {
        bar.classList.remove('sticky', 'top-16', 'z-30');
      }

      const container = bar.closest('[data-tour-filter-container]');
      if (!container) return;

      const searchInput = bar.querySelector<HTMLInputElement>(
        '[data-filter-search]'
      );
      const selects = bar.querySelectorAll<HTMLSelectElement>(
        '[data-filter-select]'
      );
      const sortSelect =
        bar.querySelector<HTMLSelectElement>('[data-filter-sort]');
      const countEl = bar.querySelector<HTMLElement>('[data-filter-count]');
      const chipsEl = bar.querySelector<HTMLElement>('[data-filter-chips]');
      const clearBtn = bar.querySelector<HTMLButtonElement>(
        '[data-filter-clear]'
      );
      const emptyEl = bar.querySelector<HTMLElement>('[data-filter-empty]');
      const facetsEl = bar.querySelector<HTMLElement>('[data-filter-facets]');
      const toggleBtn = bar.querySelector<HTMLButtonElement>(
        '[data-filter-toggle]'
      );
      const toggleLabel = bar.querySelector<HTMLElement>(
        '[data-filter-toggle-label]'
      );
      const closeBtn = bar.querySelector<HTMLButtonElement>(
        '[data-filter-close]'
      );
      const applyBtn = bar.querySelector<HTMLButtonElement>(
        '[data-filter-apply]'
      );
      const backdrop = document.querySelector<HTMLElement>(
        '[data-filter-backdrop]'
      );

      const totalCount = parseInt(bar.dataset.totalCount ?? '0', 10);
      const resultTemplate =
        bar.dataset.resultTemplate ?? 'Showing $1 of $2 tours';
      const availableTemplate =
        bar.dataset.availableTemplate ?? '$1 tours available';
      const filtersLabel = bar.dataset.filtersLabel ?? 'Filters';
      const filtersCountTemplate =
        bar.dataset.filtersCountTemplate ?? 'Filters ($1)';
      const applyTemplate = bar.dataset.applyTemplate ?? 'Show $1 tours';

      const cards = () =>
        container.querySelectorAll<HTMLElement>('.tour-card-filterable');
      const sections = () =>
        container.querySelectorAll<HTMLElement>('[data-tour-section]');

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      const selectAttrMap: Record<string, string> = {
        region: 'data-tour-region',
        tag: 'data-tour-tags'
      };

      // Only the first bar owns the URL: two bars writing the same query keys
      // would overwrite each other on every change.
      const ownsUrl = barIndex === 0;

      /* ------------------------------------------------------------------ *
       * URL state
       * ------------------------------------------------------------------ */

      function readFromUrl() {
        const params = new URLSearchParams(window.location.search);
        if (searchInput) searchInput.value = params.get(PARAM.q) ?? '';
        selects.forEach((sel) => {
          const key = sel.dataset.filterSelect ?? '';
          const param = PARAM[key as keyof typeof PARAM];
          const value = param ? (params.get(param) ?? '') : '';
          // Match on the slug the URL carries, falling back to the raw id so
          // links shared before slugs existed keep working. A value this page
          // has no option for is ignored rather than blanking the select into
          // a state the reader cannot see.
          const match = value
            ? Array.from(sel.options).find(
                (o) => o.dataset.slug === value || o.value === value
              )
            : undefined;
          sel.value = match?.value ?? '';
        });
        if (sortSelect) sortSelect.value = params.get(PARAM.sort) ?? '';
      }

      function writeToUrl() {
        if (!ownsUrl) return;
        const params = new URLSearchParams(window.location.search);
        const set = (key: string, value: string) => {
          if (value) params.set(key, value);
          else params.delete(key);
        };

        set(PARAM.q, searchInput?.value.trim() ?? '');
        selects.forEach((sel) => {
          const key = sel.dataset.filterSelect ?? '';
          const param = PARAM[key as keyof typeof PARAM];
          if (!param) return;
          const selected = sel.options[sel.selectedIndex];
          set(param, sel.value ? (selected?.dataset.slug ?? sel.value) : '');
        });
        set(PARAM.sort, sortSelect?.value ?? '');

        const query = params.toString();
        const next = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
        // replaceState, not pushState: typing in a search box should not bury
        // the previous page under a dozen history entries.
        window.history.replaceState(null, '', next);
      }

      /* ------------------------------------------------------------------ *
       * Sorting
       * ------------------------------------------------------------------ */

      // Sorting by `order` on the grid item rather than moving DOM nodes: no
      // reparenting, no lost focus, and the browser animates the reflow of
      // items that already have a transition on them.
      function applySort() {
        const key = (sortSelect?.value ?? '') as SortKey;
        const list = Array.from(cards());

        if (!key) {
          list.forEach((card) => {
            card.style.order = '';
          });
          return;
        }

        const [field, direction] = key.split('-') as [string, 'asc' | 'desc'];
        const attr = `data-sort-${field}`;
        // Missing values sort last in both directions — a tour with no price
        // is not the cheapest one.
        const valueOf = (card: HTMLElement) => {
          const raw = card.getAttribute(attr);
          const n = raw ? Number(raw) : NaN;
          return Number.isFinite(n) ? n : null;
        };

        list
          .slice()
          .sort((a, b) => {
            const av = valueOf(a);
            const bv = valueOf(b);
            if (av === null && bv === null) return 0;
            if (av === null) return 1;
            if (bv === null) return -1;
            return direction === 'desc' ? bv - av : av - bv;
          })
          .forEach((card, index) => {
            card.style.order = String(index + 1);
          });
      }

      /* ------------------------------------------------------------------ *
       * Filtering
       * ------------------------------------------------------------------ */

      function activeFilters() {
        return Array.from(selects)
          .filter((sel) => sel.value)
          .map((sel) => ({
            select: sel,
            key: sel.dataset.filterSelect ?? '',
            value: sel.value,
            facetLabel: sel.dataset.filterLabel ?? '',
            optionLabel:
              sel.options[sel.selectedIndex]?.textContent?.trim() ?? ''
          }));
      }

      function renderChips(active: ReturnType<typeof activeFilters>) {
        if (!chipsEl) return;
        chipsEl.textContent = '';
        if (active.length === 0) {
          chipsEl.classList.add('hidden');
          chipsEl.classList.remove('flex');
          return;
        }
        chipsEl.classList.remove('hidden');
        chipsEl.classList.add('flex');

        active.forEach(({ select, facetLabel, optionLabel }) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className =
            'inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20 dark:bg-emerald-300/15 dark:text-emerald-200';
          chip.setAttribute(
            'aria-label',
            `${facetLabel}: ${optionLabel} — ${filtersLabel}`
          );
          chip.append(document.createTextNode(optionLabel));
          const x = document.createElement('i');
          x.className = 'icon-[ph--x] h-3 w-3';
          x.setAttribute('aria-hidden', 'true');
          chip.append(x);
          chip.addEventListener('click', () => {
            select.value = '';
            applyFilters();
          });
          chipsEl.append(chip);
        });
      }

      function applyFilters() {
        const query = (searchInput?.value ?? '').toLowerCase().trim();
        const active = activeFilters();
        const activeSelects = active
          .filter(({ key }) => selectAttrMap[key])
          .map(({ key, value }) => ({ attr: selectAttrMap[key], value }));

        const hasActiveFilters = query.length > 0 || activeSelects.length > 0;
        let visibleIndex = 0;

        cards().forEach((card) => {
          // Search across region, tags and the excerpt, not just the title:
          // "Douro" matched nothing unless a tour happened to be named for it.
          const haystack =
            card.getAttribute('data-search-text') ??
            card.getAttribute('data-tour-title') ??
            '';
          const matchesSearch = !query || haystack.includes(query);

          const matchesSelects = activeSelects.every(({ attr, value }) => {
            const attrVal = card.getAttribute(attr) ?? '';
            if (attr === 'data-tour-region') return attrVal === value;
            return attrVal.split(' ').includes(value);
          });

          const visible = matchesSearch && matchesSelects;

          if (visible) {
            showCard(card, visibleIndex);
            visibleIndex++;
          } else {
            hideCard(card);
          }
        });

        applySort();

        if (countEl) {
          countEl.textContent = hasActiveFilters
            ? resultTemplate
                .replace('$1', String(visibleIndex))
                .replace('$2', String(totalCount))
            : availableTemplate.replace('$1', String(totalCount));
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', !hasActiveFilters);
        }

        if (toggleLabel) {
          toggleLabel.textContent =
            activeSelects.length > 0
              ? filtersCountTemplate.replace('$1', String(activeSelects.length))
              : filtersLabel;
        }

        if (applyBtn) {
          applyBtn.textContent = applyTemplate.replace(
            '$1',
            String(visibleIndex)
          );
        }

        renderChips(active);

        if (emptyEl) {
          emptyEl.classList.toggle(
            'hidden',
            visibleIndex > 0 || !hasActiveFilters
          );
        }

        sections().forEach((section) => {
          const sectionCards = section.querySelectorAll<HTMLElement>(
            '.tour-card-filterable'
          );
          const hasVisible = Array.from(sectionCards).some(
            (c) => !c.hasAttribute('data-filter-hidden')
          );
          section.style.display = hasVisible ? '' : 'none';
        });

        writeToUrl();
      }

      function hideCard(card: HTMLElement) {
        if (card.hasAttribute('data-filter-hidden')) return;

        if (prefersReducedMotion) {
          card.setAttribute('data-filter-hidden', '');
          card.style.display = 'none';
          return;
        }

        card.setAttribute('data-filter-hidden', '');
        card.style.transitionDelay = '';

        const onEnd = () => {
          card.removeEventListener('transitionend', onEnd);
          if (card.hasAttribute('data-filter-hidden')) {
            card.style.display = 'none';
          }
        };
        card.addEventListener('transitionend', onEnd, { once: true });

        setTimeout(() => {
          if (card.hasAttribute('data-filter-hidden')) {
            card.style.display = 'none';
          }
        }, 400);
      }

      function showCard(card: HTMLElement, index: number) {
        if (
          !card.hasAttribute('data-filter-hidden') &&
          card.style.display !== 'none'
        ) {
          card.style.transitionDelay = '';
          return;
        }

        if (prefersReducedMotion) {
          card.removeAttribute('data-filter-hidden');
          card.style.display = '';
          card.style.transitionDelay = '';
          return;
        }

        card.style.display = '';
        // Force reflow
        void card.offsetHeight;
        // Was `index * 0.05s`, which put the 20th card almost a second behind
        // the first. Capped at four steps of the shared 40ms motion unit.
        card.style.transitionDelay = `${Math.min(index, 4) * 40}ms`;
        card.removeAttribute('data-filter-hidden');

        const onEnd = () => {
          card.removeEventListener('transitionend', onEnd);
          card.style.transitionDelay = '';
        };
        card.addEventListener('transitionend', onEnd, { once: true });

        setTimeout(() => {
          card.style.transitionDelay = '';
        }, 500);
      }

      /* ------------------------------------------------------------------ *
       * Mobile filter sheet
       * ------------------------------------------------------------------ */

      function openSheet() {
        if (!facetsEl) return;
        facetsEl.setAttribute('data-open', '');
        toggleBtn?.setAttribute('aria-expanded', 'true');
        backdrop?.removeAttribute('hidden');
        backdrop?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        facetsEl.querySelector<HTMLElement>('select')?.focus();
      }

      function closeSheet() {
        if (!facetsEl) return;
        facetsEl.removeAttribute('data-open');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        backdrop?.setAttribute('hidden', '');
        backdrop?.classList.add('hidden');
        document.body.style.overflow = '';
        toggleBtn?.focus();
      }

      toggleBtn?.addEventListener('click', () => {
        if (facetsEl?.hasAttribute('data-open')) closeSheet();
        else openSheet();
      });
      closeBtn?.addEventListener('click', closeSheet);
      applyBtn?.addEventListener('click', closeSheet);
      backdrop?.addEventListener('click', closeSheet);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && facetsEl?.hasAttribute('data-open')) {
          closeSheet();
        }
      });

      /* ------------------------------------------------------------------ *
       * Wiring
       * ------------------------------------------------------------------ */

      let searchTimeout: ReturnType<typeof setTimeout>;
      searchInput?.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(applyFilters, 200);
      });

      selects.forEach((sel) => sel.addEventListener('change', applyFilters));
      sortSelect?.addEventListener('change', applyFilters);

      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        selects.forEach((sel) => {
          sel.value = '';
        });
        applyFilters();
      });

      // Back/forward between filtered views of the same page.
      if (ownsUrl) {
        window.addEventListener('popstate', () => {
          readFromUrl();
          applyFilters();
        });
      }

      readFromUrl();
      applyFilters();
    });
  }

  initTourFilter();
  document.addEventListener('astro:page-load', initTourFilter);
</script>
