---
import WeTravelBooking from './wetravel-booking.astro';
import Linkbutton from 'src/components/building-blocks/linkbutton/linkbutton.astro';
import TourForm from './tour-form.astro';
import { t } from 'utils/i18n';
import type { InferEntrySchema } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';

/**
 * Tour "Book Now" call-to-action. WeTravel takes priority, then the
 * FareHarbor/Bokun deep-link, then the email enquiry form.
 *
 * variant:
 *  - 'panel'  (sidebar): full experience — falls back to the inline enquiry form.
 *  - 'inline' (after a pricing table): button-only — the no-booking-provider
 *    fallback links up to the sidebar form (#tour-booking) instead of repeating
 *    the whole form under every table.
 */
type Props = {
  tour: InferEntrySchema<'tours'>;
  language: LanguageCodes;
  variant?: 'panel' | 'inline' | 'column';
  buttonClass?: string;
};

const { tour, language, variant = 'panel', buttonClass } = Astro.props;
const { wetravel, feature } = tour;
const hasWetravel = !!(wetravel?.guidedUuid || wetravel?.selfGuidedUuid);
const bookLabel = t('Tour.Form.Button.Text', language);

// Secondary treatment for the sidebar's booking button, so it reads as the
// alternative to the accent-coloured enquiry action above it rather than as a
// second, competing primary.
const secondaryButtonClass =
  'border border-primary bg-transparent text-primary hover:bg-primary hover:text-white dark:border-emerald-300 dark:text-emerald-300 dark:hover:bg-emerald-300 dark:hover:text-gray-900';
---

{
  variant === 'panel' ? (
    /*
     * Enquiry and booking are siblings now, not nested. They used to be one
     * blue button stacked on one green button of the same size — two equal
     * primaries, which is a coin toss rather than a choice. The enquiry
     * <summary> carries the accent and the booking button drops to an outline
     * below it; and because booking sits outside the collapsed form, a visitor
     * who is ready to buy still sees "Book now" without opening anything.
     */
    <div class="flex w-full flex-col gap-3">
      <TourForm code={tour.code} title={tour.title} />
      {hasWetravel ? (
        <WeTravelBooking
          guidedUuid={wetravel?.guidedUuid}
          selfGuidedUuid={wetravel?.selfGuidedUuid}
          uid={wetravel?.uid}
          label={bookLabel}
          guidedLabel={t('Tour.Booking.Guided', language)}
          selfGuidedLabel={t('Tour.Booking.SelfGuided', language)}
          buttonClass={buttonClass ?? secondaryButtonClass}
        />
      ) : feature?.bokunLink ? (
        <Linkbutton
          href={feature.bokunLink}
          title={bookLabel}
          stretch
          class={buttonClass ?? secondaryButtonClass}
        >
          {bookLabel}
        </Linkbutton>
      ) : null}
    </div>
  ) : hasWetravel ? (
    <WeTravelBooking
      guidedUuid={wetravel?.guidedUuid}
      selfGuidedUuid={wetravel?.selfGuidedUuid}
      uid={wetravel?.uid}
      label={bookLabel}
      guidedLabel={t('Tour.Booking.Guided', language)}
      selfGuidedLabel={t('Tour.Booking.SelfGuided', language)}
      buttonClass={buttonClass}
    />
  ) : feature?.bokunLink ? (
    <Linkbutton
      href={feature.bokunLink}
      title={bookLabel}
      stretch={variant !== 'column'}
      class={buttonClass}
    >
      {bookLabel}
    </Linkbutton>
  ) : (
    <Linkbutton
      href="#tour-booking"
      title={bookLabel}
      stretch={variant !== 'column'}
      class={buttonClass}
    >
      {bookLabel}
    </Linkbutton>
  )
}
