---
import SiteData from 'src/../data/site.json';
import { cn } from 'utils/cn';
// The brand mark lives in this app's assets; Astro inlines the SVG so it can
// be sized with classes and picks up `currentColor` for the wordmark.
import LogoMark from 'src/assets/images/logo.svg';
type Props = {
  class?: string;
};

const { class: className = '' } = Astro.props;

const { site_title } = (SiteData as any)[Astro.currentLocale ?? 'en'];
---

<LogoMark
  role="img"
  aria-label={site_title}
  class={cn(
    // Compact, natural-aspect logo on mobile (the art is ~6:1); restore the
    // larger desktop size at md+.
    'h-10 w-auto fill-black text-black md:h-28 md:w-80 dark:fill-white dark:text-white',
    className
  )}
/>
