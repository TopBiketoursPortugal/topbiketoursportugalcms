---
import ToggleMenu from './ToggleMenu.astro';
import ToggleTheme from './ToggleTheme.astro';
import Logo from './Logo.astro';
import LanguageMenu from './LanguageMenu.astro';
import ToursMegaMenu from 'src/components/navigation/mega-menu/ToursMegaMenu.astro';
import { getHomePermalink, trimSlash } from 'utils/permalinks';
import type { HTMLAttributes } from 'astro/types';
import type { LanguageCodes } from 'src/schemas/language';
import type { HrefLang } from 'src/types/hreflang';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  enabled?: boolean;
}

// `megaMenu: true` opens the tours panel with its defaults; an object lets the
// site say which tour types the panel lists (data/navigation.json).
export type MegaMenuConfig = { tourTypes?: string[] };

interface MenuLink extends Link {
  links?: Array<MenuLink>;
  megaMenu?: boolean | MegaMenuConfig;
}

export interface CallToAction extends Omit<HTMLAttributes<'a'>, 'slot'> {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'link';
  text?: string;
  icon?: string;
  classes?: Record<string, string>;
  target: astroHTML.JSX.HTMLAttributeAnchorTarget;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  isSticky?: boolean;
  isFullWidth?: boolean;
  position?: string;
  hrefLangs?: ReadonlyArray<HrefLang>;
}

const {
  id = 'header',
  links = [],
  isSticky = false,
  position = 'center',
  hrefLangs
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky },
    'top-0 z-50 mx-auto w-full flex-none border-b border-gray-50/0 bg-slate-50 transition-opacity ease-in-out dark:bg-slate-950'
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class="text-default relative z-50 flex w-full justify-between px-3 py-3 md:px-6"
  >
    <div
      class:list={[
        { 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' },
        'flex w-full justify-between md:w-auto'
      ]}
    >
      <a
        class="flex items-center"
        href={getHomePermalink(Astro.currentLocale as LanguageCodes)}
        title="Home"
      >
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="hidden w-full items-center overflow-x-hidden overflow-y-auto text-slate-900 md:mx-5 md:flex md:w-auto md:justify-self-center md:overflow-visible dark:text-slate-300"
      aria-label="Main navigation"
    >
      <ul
        class="flex w-full flex-col overflow-clip text-xl font-medium tracking-[0.01rem] md:w-auto md:flex-row md:justify-center md:self-center md:overflow-visible md:text-[0.9375rem]"
      >
        {
          links
            .filter(({ enabled }) => enabled ?? true)
            .map(({ text, href, links, megaMenu }) =>
              megaMenu ? (
                <ToursMegaMenu
                  text={text ?? ''}
                  href={href ?? ''}
                  language={language}
                  config={typeof megaMenu === 'object' ? megaMenu : undefined}
                  isActive={href === currentPath}
                />
              ) : (
                <li class={links?.length ? 'dropdown' : ''}>
                  {links?.length ? (
                    <>
                      <a
                        href={href}
                        class:list={[
                          'hover:text-link flex items-center gap-1 px-4 py-3 text-2xl whitespace-nowrap',
                          { 'aw-link-active': href === currentPath }
                        ]}
                      >
                        {text}
                        <i
                          class="icon-[ph--caret-down-light] hidden h-4 w-4 transition-transform duration-200 md:inline"
                          aria-hidden="true"
                        />
                      </a>
                      <ul class="dropdown-menu rounded pl-4 font-medium text-black drop-shadow-xl md:absolute md:hidden md:min-w-50 md:bg-white md:pl-0 md:backdrop-blur-md dark:md:bg-slate-900 dark:md:text-slate-200">
                        {links.map(({ text: text2, href: href2 }) => (
                          <li>
                            <a
                              class:list={[
                                'hover:text-link whitespace-no-wrap block px-5 py-2 first:rounded-t last:rounded-b',
                                { 'aw-link-active': href2 === currentPath }
                              ]}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <a
                      class:list={[
                        'hover:text-link flex items-center px-4 py-3 text-2xl whitespace-nowrap',
                        { 'aw-link-active': href === currentPath }
                      ]}
                      href={href}
                    >
                      {text}
                    </a>
                  )}
                </li>
              )
            )
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:mr-auto rtl:ml-0': position === 'left' },
        'fixed bottom-0 left-0 hidden w-full items-center justify-end p-3 md:static md:mb-0 md:flex md:w-auto md:self-center md:justify-self-end md:p-0 rtl:right-0 rtl:left-auto'
      ]}
    >
      <div class="flex w-full items-center justify-between gap-4 md:w-auto">
        <div class="md:hidden">
          <LanguageMenu
            localizedUrls={hrefLangs?.map((l) => ({
              code: l.hreflang,
              path: l.href
            }))}
          />
        </div>

        <div class="md:hidden">
          <ToggleTheme iconClass="w-6 h-6" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    anchor-name: --header;
  }

  /* Desktop dropdown reveal (mobile shows the submenu inline) */
  @media (min-width: 768px) {
    .dropdown {
      position: relative;
    }

    .dropdown:hover > .dropdown-menu,
    .dropdown:focus-within > .dropdown-menu {
      display: block;
    }

    .dropdown > .dropdown-menu {
      top: 100%;
      left: 0;
      padding-block: 0.5rem;
    }

    .dropdown:hover > a .icon-\[ph--caret-down-light\],
    .dropdown:focus-within > a .icon-\[ph--caret-down-light\] {
      transform: rotate(180deg);
    }
  }
</style>
