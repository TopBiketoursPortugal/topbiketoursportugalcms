---
import ContactsData from 'src/../data/contact.json';
import type { ContactSchema } from 'src/schemas/contact';
import type { LanguageCodes } from 'src/schemas/language';
import { cleanPhoneNumberFormatting } from 'utils/clean-phone-number-formatting';
import { cn } from 'utils/cn';
import { t } from 'utils/i18n';

type Props = {
  class?: string;
};

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;

const { class: className } = Astro.props;

const contact = ContactsData[language] satisfies ContactSchema;

const style = cn(
  'grid grid-cols-1 gap-6 p-4 placeholder-blue-400 lg:p-12 lg:grid-cols-3',
  className
);
---

<div class={style}>
  <div class="flex flex-col items-center gap-6">
    <i class="icon-[ph--phone-light] h-12 w-12 pb-4" aria-hidden="true"></i>
    <h3 class="font-bold">{t('Contact.Feature.Phone.Label', language)}</h3>
    <h6 class="text-center text-pretty text-slate-600">
      {t('Contact.Feature.Phone.Description', language)}
    </h6>
    {
      contact && (contact.phone || contact.cellPhone) && (
        <>
          <div class="flex-grow" />
          <div class="grid grid-cols-1 items-center gap-4 xl:grid-cols-2">
            {contact.cellPhone && (
              <a href={'tel:' + cleanPhoneNumberFormatting(contact.cellPhone)}>
                {contact.cellPhone}
              </a>
            )}
            {contact.cellPhone && (
              <a
                href={
                  'https://wa.me/' +
                  cleanPhoneNumberFormatting(contact.cellPhone)
                }
                target="_blank"
                rel="nofollow noopener noreferrer"
                aria-label="Chat on WhatsApp"
                class="flex items-center gap-1"
              >
                <i
                  class="icon-[ph--whatsapp-logo-light] text-md"
                  aria-hidden="true"
                />
                <span>whatsapp</span>
              </a>
            )}
          </div>
        </>
      )
    }
  </div>
  <div class="flex flex-col items-center gap-6">
    <i class="icon-[ph--envelope-light] h-12 w-12 pb-4" aria-hidden="true"></i>
    <h3 class="font-bold">{t('Contact.Feature.Email.Label', language)}</h3>
    <h6 class="text-center text-pretty text-slate-600">
      {t('Contact.Feature.Email.Description', language)}
    </h6>
    {
      contact && contact.email && (
        <>
          <div class="flex-grow" />
          <a href={'mailto:' + contact.email} aria-label="Email">
            {contact.email}
          </a>
        </>
      )
    }
  </div>
  <div class="flex flex-col items-center gap-6">
    <i
      class="icon-[ph--navigation-arrow-light] h-12 w-12 pb-4"
      aria-hidden="true"></i>
    <h3 class="font-bold">{t('Contact.Feature.Address.Label', language)}</h3>
    <h6 class="text-center text-pretty text-slate-600">
      {t('Contact.Feature.Address.Description', language)}
    </h6>

    {
      contact && contact.address && contact.address.map && (
        <>
          <div class="flex-grow" />
          <a href={contact.address.map} target="_blank" role="button">
            {t('Contact.Feature.Address.LinkText', language)}
          </a>
        </>
      )
    }
  </div>
</div>
