---
import slugify from 'slugify';
import BlogList from 'src/components/blog/list.astro';
import BlogPagination from 'src/components/blog/pagination.astro';
import InfiniteScroll from 'src/components/blog/infinite-scroll.astro';
import Layout from 'src/layouts/Layout.astro';
import PageHelper from 'src/shared/astro/page.astro';
import { getCollection } from 'astro:content';
import { getBlogIndexPage, getBlogTagLanguagesAlternates, getBlogTagPath, trailingSlash } from 'utils/permalinks';
import { languageCodes, type LanguageCodes } from 'src/schemas/language';
import LanguageData from 'src/../data/languages.json';
import { t } from 'utils/i18n';
import { getHomeCrumb, getBlogCrumb } from 'utils/breadcrumbs';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection('blog');
  const postTags = await getCollection('postTags');

  const pageIndex = await Promise.all(
    languageCodes.map((language) => getBlogIndexPage(language))
  );

  return languageCodes.flatMap((language) => {
    const filteredPosts = posts.filter((p) => p.data.language === language);
    const langTags = postTags.filter((t) => t.data.language === language);

    const page = pageIndex.filter((p) => p.data.language === language)[0];
    const pageSize =
      page?.data && 'page_size' in page?.data ? page?.data.page_size : 6;

    return langTags.flatMap((tag) => {
      const tagPosts = filteredPosts
        .filter(({ data }) => data.tags?.includes(tag.data.id))
        .sort((a, b) => {
          const dateA = new Date(a.data.date).getTime();
          const dateB = new Date(b.data.date).getTime();
          return dateB - dateA;
        });

      return paginate(tagPosts, {
        params: {
          language: language === 'en' ? undefined : language,
          tag:
            slugify(tag.data.name ?? tag.data.title, { lower: true, strict: true, trim: true }) +
            trailingSlash
        },
        props: { tagData: tag },
        pageSize
      });
    });
  });
}

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const { tagData } = Astro.props;
const tagName = tagData.data.name ?? tagData.data.title;
const { page: pageNumberStr } = Astro.params;

const blogTagPageTitle = pageNumberStr
  ? t('Blog.Tags.Paged.Title', language)
      .replace('$1', tagName)
      .replace('$2', pageNumberStr)
  : t('Blog.Tags.Paged.Title', language)
      .replace('$1', tagName)
      .replace('$2', '1');

const blogTagPageDescription = tagData.data.seo?.page_description ?? blogTagPageTitle;

const seo = {
  page_title: blogTagPageTitle,
  page_description: blogTagPageDescription
};

const pagination = Astro.props.page;
const filteredPosts = pagination.data;

const hrefs = await getBlogTagLanguagesAlternates(tagData, Astro.site);
const currentPageUrl = Astro.url.href;
const hrefsWithSelf = hrefs.some((h) => h.hreflang === language)
  ? hrefs.map((h) => (h.hreflang === language ? { ...h, href: currentPageUrl } : h))
  : [...hrefs, { href: currentPageUrl, hreflang: language }];
const defaultLocale = LanguageData.en;
const defaultHref = hrefsWithSelf.filter((h) => h.hreflang === defaultLocale.code)[0];
const breadcrumbs = [
  getHomeCrumb(language),
  getBlogCrumb(language),
  { name: tagName, url: getBlogTagPath(tagData, language) }
];
---

<Layout
  title={blogTagPageTitle}
  seo={seo}
  hrefLangs={hrefsWithSelf}
  breadcrumbs={breadcrumbs}
>
  <slot slot="head">
    {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefsWithSelf.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>
  <div class="py-24">
    <PageHelper bookshop:live contentBlocks={tagData.data.content_blocks ?? []} />
    <h1
      class="my-12 text-center text-3xl font-semibold first-letter:capitalize sm:text-4xl md:text-5xl lg:text-6xl"
    >
      {tagName}
    </h1>
    <section class="blog-index mx-auto">
      <BlogList posts={filteredPosts} />
      <BlogPagination pagination={pagination} />
      <InfiniteScroll />
    </section>
    <PageHelper bookshop:live contentBlocks={tagData.data.content_blocks_after ?? []} />
  </div>
</Layout>
