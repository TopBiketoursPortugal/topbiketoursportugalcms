---
import { getCollection } from 'astro:content';
import Layout from 'src/layouts/Layout.astro';
import { languageCodes, type LanguageCodes } from 'src/schemas/language';
import Heading from 'src/components/typography/heading.astro';
import Stack from 'src/components/stack/stack.astro';
import TourTagsCard from 'src/components/collection/tour-tags-card.astro';
import { t } from 'utils/i18n';
import { getTourTagsListingPath, trailingSlash } from 'utils/permalinks';
import { getHomeCrumb, getToursCrumb } from 'utils/breadcrumbs';
import LanguageData from 'src/../data/languages.json';
import SiteData from 'src/../data/site.json';

export async function getStaticPaths() {
  return languageCodes.map((language) => ({
    params: {
      language: language === 'en' ? undefined : language
    },
    props: { language }
  }));
}

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;

const tags = await getCollection(
  'tourTags',
  (t) => t.data.language === language
);

const tours = await getCollection(
  'tours',
  (t) => t.data.language === language
);

const tagCounts = new Map<string, number>();
for (const tag of tags) {
  const count = tours.filter((t) => (t.data.tags ?? []).includes(tag.data.id)).length;
  tagCounts.set(tag.data.id, count);
}

const visibleTags = tags.filter((t) => (tagCounts.get(t.data.id) ?? 0) > 0);

const pageTitle = t('Tour.TagsPageTitle', language);

const hrefs = languageCodes.map((lang) => ({
  href: `${Astro.site}${lang === 'en' ? '' : lang + '/'}tours/tags${trailingSlash}`,
  hreflang: lang
}));

const defaultHref = hrefs.find((h) => h.hreflang === 'en');

const breadcrumbs = [
  getHomeCrumb(language),
  getToursCrumb(language),
  { name: t('Tour.TagsTitle', language), url: getTourTagsListingPath(language) }
];
---

<Layout
  class="mb-16 px-8"
  title={pageTitle}
  hrefLangs={hrefs}
  breadcrumbs={breadcrumbs}
>
  <slot slot="head">
    {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefs.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>
  <Stack spacing="large" layout="vertical" class="pt-6">
    <Heading as="h1" class="px-6">{pageTitle}</Heading>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        visibleTags.map((tag) => (
          <TourTagsCard
            tag={tag}
            language={language}
            tourCount={tagCounts.get(tag.data.id) ?? 0}
            imageWidths={[300]}
          />
        ))
      }
    </div>
  </Stack>
</Layout>
