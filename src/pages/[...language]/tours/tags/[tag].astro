---
import { getCollection } from 'astro:content';
import slugify from 'slugify';
import Layout from 'src/layouts/Layout.astro';
import TourList from 'src/components/tours/tour-list.astro';
import { getTourTagLanguagesAlternates, getTourTagPath, getTourTagsListingPath, trailingSlash } from 'utils/permalinks';
import { languageCodes, type LanguageCodes } from 'src/schemas/language';
import Heading from 'src/components/typography/heading.astro';
import Text from 'src/components/typography/text.astro';
import Stack from 'src/components/stack/stack.astro';
import PageHelper from 'src/shared/astro/page.astro';
import LanguageData from 'src/../data/languages.json';

import { getImage } from 'astro:assets';
import { t } from 'utils/i18n';
import { getHomeCrumb, getToursCrumb } from 'utils/breadcrumbs';
import TourFilterBar from 'src/components/tours/tour-filter-bar.astro';

export async function getStaticPaths({ paginate: _ }: { paginate: Function }) {
  const tours = await getCollection('tours');
  const tourTags = await getCollection('tourTags');

  return languageCodes.flatMap((language) => {
    return tourTags
      .filter((tr) => tr.data.language === language)
      .map((tag) => ({
        params: {
          language: language === 'en' ? undefined : language,
          // toursType: PermalinkData.tours[language],
          tag:
            slugify(tag.data.name??tag.data.title, {
              lower: true,
              strict: true,
              trim: true
            }) + trailingSlash
        },
        props: {
          tagData: tag,
          tours:
            tours.filter(
              (tour) =>
                tour.data.tags?.includes(tag.data.id) &&
                tour.data.language === language
            ) ?? []
        }
      }));
  });
}
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const { tours, tagData } = Astro.props;

const packageTours = tours.filter((t) => t.data.tourtype === 'PackageTour');
const dayTours = tours.filter((t) => t.data.tourtype === 'DayTour');

const tourTags = await getCollection(
  'tourTags',
  (f) => f.data.language === language
);

const allRegions = await getCollection('tourRegions', (f) => f.data.language === language);
const allRiderLevels = await getCollection('tourRiderLevels', (f) => f.data.language === language);
const allBikeCategories = await getCollection('bikeCategories', (f) => f.data.language === language);

const tourRegionIds = new Set(tours.map((t) => t.data.region).filter(Boolean));
const tourRiderLevelIds = new Set(tours.flatMap((t) => t.data.riderLevels ?? []));
const tourBikeCategoryIds = new Set(tours.flatMap((t) => t.data.bikeCategories ?? []));

const relevantRegions = allRegions.filter((r) => tourRegionIds.has(r.data.id));
const relevantRiderLevels = allRiderLevels.filter((l) => tourRiderLevelIds.has(l.data.id));
const relevantBikeCategories = allBikeCategories.filter((c) => tourBikeCategoryIds.has(c.data.id));

const baseUrl = Astro.site;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,avif,webp}',
  { eager: true }
);

const image = tagData.data.seo?.featured_image ? await getImage({
  src: images[tagData.data.seo?.featured_image].default,
  format: 'png'
}) : null;

const imageSrc = image?.src?.startsWith('/') ? image.src?.substring(1) : image?.src;
const tagSeoTitle = tagData.data.seo?.page_title ?? tagData.data.title;
const tagSeoDescription = tagData.data.seo?.page_description ?? tagData.data.title;
const frontmatter = {
  title: tagData.data.title ?? tagData.data.seo?.page_title,
  page_size: 6,
  seo: {
    page_title: tagSeoTitle,
    page_description: tagSeoDescription,
    featured_image: tagData.data.seo?.featured_image,
    featured_image_alt: tagData.data.seo?.featured_image_alt ?? tagSeoTitle,
    canonical_url: tagData.data.seo?.canonical_url,
    open_graph_type: tagData.data.seo?.open_graph_type,
    author_twitter_handle: tagData.data.seo?.author_twitter_handle,
    no_index: false
  }
};
const hrefs = await getTourTagLanguagesAlternates(tagData, Astro.site);
const currentPageUrl = Astro.url.href;
const hrefsWithSelf = hrefs.some((h) => h.hreflang === language)
  ? hrefs.map((h) => (h.hreflang === language ? { ...h, href: currentPageUrl } : h))
  : [...hrefs, { href: currentPageUrl, hreflang: language }];
const defaultLocale = LanguageData.en;
const defaultHref = hrefsWithSelf.filter((h) => h.hreflang === defaultLocale.code)[0];
const breadcrumbs = [
  getHomeCrumb(language),
  getToursCrumb(language),
  { name: t('Tour.TagsTitle', language), url: getTourTagsListingPath(language) },
  { name: tagData.data.name ?? tagData.data.title, url: getTourTagPath(tagData, language) }
];
---

<Layout class="mb-16 px-8"
  {...frontmatter}
  title={t("Tours.Tags.PackageTour.Title", language).replace("$1",tagData.data.name ?? tagData.data.title)} hrefLangs={hrefsWithSelf} breadcrumbs={breadcrumbs}>
  <slot slot="head">
      {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefsWithSelf.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>
<Stack spacing="large" layout="vertical" class="pt-6">
  <Heading as="h1" class="px-6">{tagData.data.title ?? tagData.data.seo?.page_title}</Heading>
  <PageHelper bookshop:live contentBlocks={tagData.data.content_blocks ?? []} />
  <div data-tour-filter-container>
    <TourFilterBar
      language={language}
      totalCount={tours.length}
      showRegion={relevantRegions.length > 0}
      showRiderLevel={relevantRiderLevels.length > 0}
      showBikeCategory={relevantBikeCategories.length > 0}
      regions={relevantRegions.map((r) => ({ id: r.data.id, name: r.data.name ?? r.data.title }))}
      riderLevels={relevantRiderLevels.map((l) => ({ id: l.data.id, name: l.data.name ?? l.data.title }))}
      bikeCategories={relevantBikeCategories.map((c) => ({ id: c.data.id, name: c.data.name ?? c.data.title }))}
    />
    {
      packageTours.length > 0 ? (
        <div data-tour-section>
          <Heading as="h2" class="px-6">{t("Tours.Tags.PackageTour.Title", language).replace("$1",tagData.data.name ?? tagData.data.title)}</Heading>
          <TourList items={packageTours} language={language} />
        </div>
      ) : null
    }
    {
      dayTours.length > 0 ? (
        <div data-tour-section>
          <Heading as="h2" class="px-6">{t("Tours.Tags.DayTour.Title", language).replace("$1",tagData.data.name ?? tagData.data.title)}</Heading>
          <TourList items={dayTours} language={language} />
        </div>
      ) : null
    }
  </div>
  {
    packageTours.length == 0 && dayTours.length === 0 ? (
      <div class="flex flex-col px-6 gap-2">
        <Text size="xlarge">{t("Tours.Tags.NoResults.Title", language).replace("$1",tagData.data.name?? tagData.data.title)}</Text>
        <Text size="large">{t("Tours.Tags.NoResults.AlternateTags.Title", language)}</Text>
        <ul class="list-disc pl-8">{tourTags.filter((r) => r.data.id !== tagData.data.id)
                        .map((r) => (<li class="pl-2"><a href={getTourTagPath(r,language)} title={r.data.name ?? r.data.title} class="underline">{r.data.name ?? r.data.title}</a></li>))}</ul>
      </div>
    ) : null
  }
  <PageHelper bookshop:live contentBlocks={tagData.data.content_blocks_after ?? []} />
</Stack>
</Layout>
