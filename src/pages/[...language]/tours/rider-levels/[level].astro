---
import { getCollection } from 'astro:content';
import slugify from 'slugify';
import Layout from 'src/layouts/Layout.astro';
import TourList from 'src/components/tours/tour-list.astro';
import { getRiderLevelLanguagesAlternates, getRiderLevelPath, getRiderLevelsListingPath, trailingSlash } from 'utils/permalinks';
import { languageCodes, type LanguageCodes } from 'src/schemas/language';
import Heading from 'src/components/building-blocks/typography/heading.astro';
import Text from 'src/components/building-blocks/typography/text.astro';
import Stack from 'src/components/building-blocks/stack/stack.astro';
import PageHelper from 'src/shared/astro/page.astro';
import LanguageData from 'src/../data/languages.json';

import { t } from 'utils/i18n';
import { getHomeCrumb, getToursCrumb } from 'utils/breadcrumbs';
import TourFilterBar from 'src/components/tours/tour-filter-bar.astro';

export async function getStaticPaths({ paginate: _ }: { paginate: Function }) {
  const tours = await getCollection('tours');
  const riderLevels = await getCollection('tourRiderLevels');

  return languageCodes.flatMap((language) => {
    return riderLevels
      .filter((rl) => rl.data.language === language)
      .map((level) => ({
        params: {
          language: language === 'en' ? undefined : language,
          level:
            slugify(level.data.path ?? level.data.name ?? level.data.title, {
              lower: true,
              strict: true,
              trim: true
            }) + trailingSlash
        },
        props: {
          levelData: level,
          tours:
            tours.filter(
              (tour) =>
                tour.data.riderLevels?.includes(level.data.id) &&
                tour.data.language === language
            ) ?? []
        }
      }));
  });
}
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const { tours, levelData } = Astro.props;

const packageTours = tours.filter((t) => t.data.tourtype === 'PackageTour');
const dayTours = tours.filter((t) => t.data.tourtype === 'DayTour');

const riderLevels = await getCollection(
  'tourRiderLevels',
  (f) => f.data.language === language
);

const allRegions = await getCollection('tourRegions', (f) => f.data.language === language);
const allTags = await getCollection('tourTags', (f) => f.data.language === language);
const allBikeCategories = await getCollection('bikeCategories', (f) => f.data.language === language);

const tourRegionIds = new Set(tours.map((t) => t.data.region).filter(Boolean));
const tourTagIds = new Set(tours.flatMap((t) => t.data.tags ?? []));
const tourBikeCategoryIds = new Set(tours.flatMap((t) => t.data.bikeCategories ?? []));

const relevantRegions = allRegions.filter((r) => tourRegionIds.has(r.data.id));
const relevantTags = allTags.filter((tg) => tourTagIds.has(tg.data.id));
const relevantBikeCategories = allBikeCategories.filter((c) => tourBikeCategoryIds.has(c.data.id));

const levelSeoTitle = levelData.data.seo?.page_title ?? levelData.data.title;
const levelSeoDescription = levelData.data.seo?.page_description ?? levelData.data.title;
const frontmatter = {
  title: levelData.data.title ?? levelData.data.seo?.page_title,
  page_size: 6,
  seo: {
    page_title: levelSeoTitle,
    page_description: levelSeoDescription,
    featured_image: levelData.data.seo?.featured_image,
    featured_image_alt: levelData.data.seo?.featured_image_alt ?? levelSeoTitle,
    canonical_url: levelData.data.seo?.canonical_url,
    open_graph_type: levelData.data.seo?.open_graph_type,
    author_twitter_handle: levelData.data.seo?.author_twitter_handle,
    no_index: false
  }
};
const hrefs = await getRiderLevelLanguagesAlternates(levelData, Astro.site);
const defaultLocale = LanguageData.en;
const defaultHref = hrefs.filter((h) => h.hreflang === defaultLocale.code)[0];
const breadcrumbs = [
  getHomeCrumb(language),
  getToursCrumb(language),
  { name: t('Tour.RiderLevelsTitle', language), url: getRiderLevelsListingPath(language) },
  { name: levelData.data.name ?? levelData.data.title, url: getRiderLevelPath(levelData, language) }
];
---

<Layout class="mb-16 px-8"
  {...frontmatter}
  title={t("Tours.RiderLevels.PackageTour.Title", language).replace("$1", levelData.data.name ?? levelData.data.title)} hrefLangs={hrefs} breadcrumbs={breadcrumbs}>
  <slot slot="head">
      {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefs.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>
<Stack spacing="large" layout="vertical" class="pt-6">
  <Heading as="h1" class="px-6">{levelData.data.title ?? levelData.data.seo?.page_title}</Heading>
  <PageHelper contentBlocks={levelData.data.content_blocks ?? []} />
  <div data-tour-filter-container>
    <TourFilterBar
      language={language}
      totalCount={tours.length}
      showRegion={relevantRegions.length > 0}
      showTag={relevantTags.length > 0}
      showBikeCategory={relevantBikeCategories.length > 0}
      regions={relevantRegions.map((r) => ({ id: r.data.id, name: r.data.name ?? r.data.title }))}
      tags={relevantTags.map((tg) => ({ id: tg.data.id, name: tg.data.name ?? tg.data.title }))}
      bikeCategories={relevantBikeCategories.map((c) => ({ id: c.data.id, name: c.data.name ?? c.data.title }))}
    />
    {
      packageTours.length > 0 ? (
        <div data-tour-section>
          <Heading as="h2" class="px-6">{t("Tours.RiderLevels.PackageTour.Title", language).replace("$1", levelData.data.name ?? levelData.data.title)}</Heading>
          <TourList items={packageTours} language={language} />
        </div>
      ) : null
    }
    {
      dayTours.length > 0 ? (
        <div data-tour-section>
          <Heading as="h2" class="px-6">{t("Tours.RiderLevels.DayTour.Title", language).replace("$1", levelData.data.name ?? levelData.data.title)}</Heading>
          <TourList items={dayTours} language={language} />
        </div>
      ) : null
    }
  </div>
  {
    packageTours.length == 0 && dayTours.length === 0 ? (
      <div class="flex flex-col px-6 gap-2">
        <Text size="xlarge">{t("Tours.RiderLevels.NoResults.Title", language).replace("$1", levelData.data.name ?? levelData.data.title)}</Text>
        <Text size="large">{t("Tours.RiderLevels.NoResults.AlternateTitle", language)}</Text>
        <ul class="list-disc pl-8">{riderLevels.filter((r) => r.data.id !== levelData.data.id)
                        .map((r) => (<li class="pl-2"><a href={getRiderLevelPath(r, language)} title={r.data.name ?? r.data.title} class="underline">{r.data.name ?? r.data.title}</a></li>))}</ul>
      </div>
    ) : null
  }
  <PageHelper contentBlocks={levelData.data.content_blocks_after ?? []} />
</Stack>
</Layout>
