---
import slugify from 'slugify';
import { getCollection, render } from 'astro:content';
import TourPage from 'src/components/tours/tour-page.astro';
import Layout, { type SEOProps } from 'src/layouts/Layout.astro';
import defaultImage from 'src/assets/images/team/sergio-marques.jpg';
import {
  getTourLanguagesAlternates,
  getTourPath,
  getTourRegionsPath,
  trailingSlash
} from 'utils/permalinks';
import type { LanguageCodes } from 'src/schemas/language';
import { getHomeCrumb, getToursCrumb } from 'utils/breadcrumbs';
import LanguageData from 'src/../data/languages.json';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => {
    return {
      params: {
        language: tour.data.language === 'en' ? undefined : tour.data.language,
        // toursType: PermalinkData.tours[tour.data.language],
        path:
          slugify(tour.data.path ?? tour.data.title, {
            lower: true,
            strict: true,
            trim: true
          }) + trailingSlash
      },
      props: {
        tour
      }
    };
  });
}

const { tour } = Astro.props;

const { Content } = await render(tour);

const seo = {
  no_index: false,
  page_title: tour.data.seo?.page_title ?? tour.data.title,
  page_description:
    tour.data.seo?.page_description ?? tour.data.description ?? tour.data.title,
  open_graph_type: 'product',
  author_twitter_handle: null,
  featured_image: tour.data.image?.src ?? defaultImage.src,
  // Alt text, not the file path — this was publishing og:image:alt as
  // "/src/assets/images/pinhao3.jpg".
  featured_image_alt: tour.data.image?.alt ?? tour.data.title,
  canonical_url: null
} satisfies SEOProps;
const hrefs = await getTourLanguagesAlternates(tour, Astro.site);
const defaultLocale = LanguageData.en;
const defaultHref = hrefs.filter((h) => h.hreflang === defaultLocale.code)[0];
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const tourRegion = tour.data.region
  ? (
      await getCollection(
        'tourRegions',
        (r) => r.data.id === tour.data.region && r.data.language === language
      )
    )[0]
  : null;
const breadcrumbs = [
  getHomeCrumb(language),
  getToursCrumb(language),
  ...(tourRegion
    ? [
        {
          name: tourRegion.data.name ?? tourRegion.data.title,
          url: getTourRegionsPath(tourRegion, language)
        }
      ]
    : []),
  { name: tour.data.title, url: getTourPath(tour.data, language) }
];
---

<Layout
  title={tour.data.title}
  seo={seo}
  hrefLangs={hrefs}
  breadcrumbs={breadcrumbs}
>
  <slot slot="head">
    {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefs.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>
  <TourPage tour={tour.data}>
    <Content />
  </TourPage>
</Layout>
