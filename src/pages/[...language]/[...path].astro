---
import PageLayout from 'src/layouts/Page.astro';
import ContactLayout from 'src/layouts/Contacts.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getPageLanguagesAlternates, getPagePath } from 'utils/permalinks';
import type { LanguageCodes } from 'src/schemas/language';
import { getHomeCrumb, type BreadcrumbItem } from 'utils/breadcrumbs';

export interface Props {
  page: CollectionEntry<'pages'>;
  language: string;
}

export async function getStaticPaths() {
  const pagesCollection = await getCollection('pages');
  var pages = pagesCollection
    // The blog index (blog.mdx and its locale copies) is `_schema: paginated`
    // — it only carries SEO/page-size config for `blog/[...page].astro`,
    // which owns the `/blog` route via `paginate()`. Rendering it here too
    // produces a duplicate `/blog` path that always loses to that route's
    // higher priority, so Astro warns and drops it on every build.
    .filter((page) => !('page_size' in page.data))
    .map((page) => {
      const path = getPagePath(page);
      // console.log(path);
      return {
        params: {
          path: path.replace(/^\/[a-z]{2}\//, '/'),
          language: page.data.language === 'en' ? undefined : page.data.language
        },
        props: { page, language: page.data.language, path }
      };
    });

  return pages;
}

const { page } = Astro.props;
const template = (page.data as any).template ?? '~/layouts/Page.astro';
const hrefs = await getPageLanguagesAlternates(page, Astro.site);
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const pagePath = getPagePath(page);
const isHomePage = !pagePath || /^\/([a-z]{2}\/)?$/.test(pagePath);
const breadcrumbs: BreadcrumbItem[] = isHomePage
  ? []
  : [getHomeCrumb(language), { name: page.data.title, url: pagePath }];
---

{
  template === '~/layouts/Contacts.astro' ? (
    <ContactLayout
      frontmatter={page.data as any}
      hrefs={hrefs}
      breadcrumbs={breadcrumbs}
    />
  ) : null
}
{
  template === '~/layouts/Page.astro' ? (
    <PageLayout
      frontmatter={page.data as any}
      hrefs={hrefs}
      breadcrumbs={breadcrumbs}
      isHomePage={isHomePage}
    />
  ) : null
}
