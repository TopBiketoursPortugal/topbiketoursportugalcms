---
import type { HrefLang } from 'src/types/hreflang';
import Layout, { type SEOProps } from './Layout.astro';
import type { FeaturedPost } from 'src/content/config';
import type { BreadcrumbItem } from 'utils/breadcrumbs';
import LanguageData from 'src/../data/languages.json';
import { cn } from '@utils/cn';

export type PaginatedProps = {
  frontmatter: {
    title: string;
    featured_posts: FeaturedPost;
    page_size?: number;
    seo?: SEOProps;
  };
  hrefs?: ReadonlyArray<HrefLang>;
  class?: string;
  breadcrumbs?: BreadcrumbItem[];
};

type Props = PaginatedProps;

if (!Astro.props.frontmatter) {
  // console.log(JSON.stringify(Astro.props), Astro.url, Astro.props);
  throw new Error('Page frontmatter must be defined missing');
}
const { frontmatter: props, hrefs = [], class: className, breadcrumbs = [] } = Astro.props;
const defaultLocale = LanguageData.en;
const defaultHref = hrefs.filter((h) => h.hreflang === defaultLocale.code)[0];
//console.log(hrefs);
---

<Layout
  {...props}
  hrefLangs={hrefs}
  breadcrumbs={breadcrumbs}
  class={cn('flex flex-col gap-3 p-3 sm:gap-10 sm:p-16', className)}
>
  <slot name="head" slot="head">
    {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefs.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
  </slot>

  <h1 class="text-3xl font-semibold sm:text-4xl md:text-5xl lg:text-6xl">
    {props.title}
  </h1>
  <slot />
</Layout>
