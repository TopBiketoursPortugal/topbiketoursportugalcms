---
import SiteData from 'src/../data/site.json';
import Icon from 'src/components/utility/icon.astro';
import { cn } from 'utils/cn';
type Props = {
  class?: string;
};

const { class: className = '' } = Astro.props;

const { site_title } = (SiteData as any)[Astro.currentLocale ?? 'en'];
---

<Icon
  icon="logo"
  title={site_title}
  className={cn(
    'h-28 w-80 fill-black text-black dark:fill-white dark:text-white',
    className
  )}
/>
