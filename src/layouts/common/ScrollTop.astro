---

<button
  type="button"
  role="button"
  aria-label="Go to top"
  title="Got to top"
  class="top fixed right-5 bottom-16 z-40 mt-[calc(100vh+50px)] flex h-12 w-12 translate-y-12 items-center justify-center rounded-full bg-slate-900 p-3 text-white opacity-0 transition-all duration-300 hover:scale-110"
  ><i
    aria-hidden="true"
    class="icon-[ph--arrow-up-light] h-7 w-7 fill-white text-white"
    title="Got to top"></i></button
>
<style>
  @keyframes adjust-scroll-button {
    to {
      opacity: 1;
      translate: 0;
    }
  }

  @supports (animation-timeline: scroll()) {
    .top {
      animation: adjust-scroll-button linear both;
    }
  }

  .top {
    animation-timeline: scroll();
    animation-range: 0 150px;
  }
</style>
