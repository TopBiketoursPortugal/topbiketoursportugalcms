---
import Icon from 'src/components/utility/icon.astro';

type Props = {
  enableSystem?: boolean;
  iconClass?: string;
};

const { enableSystem = false } = Astro.props;
---

<div class="relative inline-flex items-center gap-2">
  <p class="sr-only absolute -bottom-3 w-full text-center text-sm lg:-bottom-1">
    dark mode
  </p>

  <button
    type="button"
    class="hidden transition-transform duration-150 hover:scale-125 dark:block"
    data-theme-toggle="light"
    aria-label="Switch to light mode"
  >
    <Icon icon="ph:sun-light" />
    <span class="sr-only">light</span>
  </button>

  <button
    type="button"
    class="block transition-transform duration-150 hover:scale-125 dark:hidden"
    data-theme-toggle="dark"
    aria-label="Switch to dark mode"
  >
    <Icon icon="ph:moon-light" />
    <span class="sr-only">dark</span>
  </button>

  {
    enableSystem && (
      <button
        type="button"
        data-theme-toggle="system"
        aria-label="Switch to system theme"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7 cursor-pointer rounded-full bg-gray-100 p-1 text-gray-700 transition hover:bg-gray-200 dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-7 w-7 cursor-pointer rounded-full bg-gray-700 p-1 text-gray-100 transition dark:block dark:hover:bg-gray-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        <span class="sr-only">system</span>
      </button>
    )
  }
</div>

<style is:inline>
  /* Only keep screen reader styles as they're not available in Tailwind by default */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
