---
// The Google Tag Manager <noscript> iframe used to sit here. It was removed
// because it is the one container reference that cannot be hostname-gated:
// markup inside <noscript> runs precisely when the JavaScript that would check
// the hostname does not, so it loaded GTM-KRC3B4ZQ on every site and preview
// built from this repo. See ./tagManagerHost.ts for the gate it evaded.
//
// Removing it loses no measurement. GTM-KRC3B4ZQ contains five Google tags,
// four custom-HTML tags, and click and timer triggers — every one of which
// needs JavaScript to fire. There are no image/pixel tags, the only kind the
// <noscript> iframe can actually execute, so it has never recorded a hit.
---

<script is:inline src="/basic.js" defer></script>
<script is:inline src="/intersection-observer.js" defer></script>
<script is:inline>
  // Capture tracking parameters from URL to sessionStorage
  (function () {
    const params = new URLSearchParams(window.location.search);
    const keys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'keyword',
      'cost',
      'gclid',
      'fbclid'
    ];
    for (let i = 0; i < keys.length; i++) {
      const value = params.get(keys[i]);
      if (value) {
        try {
          sessionStorage.setItem('_track_' + keys[i], value);
        } catch (_e) {
          // sessionStorage may be unavailable (e.g. private browsing); skip.
        }
      }
    }
  })();
</script>
