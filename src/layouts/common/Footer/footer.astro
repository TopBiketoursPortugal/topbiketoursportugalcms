---
import FooterContact from './footer-contact.astro';
import Text from 'src/components/typography/text.astro';
import NavigationData from 'src/../data/navigation.json';
import { t } from 'utils/i18n';
import { getCollection } from 'astro:content';
import { getPagePath } from 'utils/permalinks';
import Stack from 'src/components/stack/stack.astro';
import type { LanguageCodes } from 'src/schemas/language';
import Logo from 'src/layouts/common/Logo.astro';
import type { CollectionEntry } from 'astro:content';
import TourRegionsCard from 'src/components/collection/tour-regions-card.astro';
import { Image } from 'astro:assets';
import BARRA_LOGOS_02 from 'src/assets/images/BARRA_LOGOS-02.png';
import BARRA_LOGOS_03 from 'src/assets/images/BARRA_LOGOS-03.png';
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const { footer } = NavigationData[language];
const { links } = footer;
const year = new Date().getFullYear();

const regions = await getCollection(
  'tourRegions',
  (r) => r.data.language === language
);

const termsPageSelector = (p: CollectionEntry<'pages'>) =>
  p.filePath?.endsWith('terms-and-conditions.mdx') &&
  (p.data.language ?? 'en') === (Astro.currentLocale ?? 'en');

const privacyPageSelector = (p: CollectionEntry<'pages'>) =>
  p.filePath?.endsWith('privacy-policy.mdx') &&
  (p.data.language ?? 'en') === (Astro.currentLocale ?? 'en');

const pageCollection = await getCollection(
  'pages',
  (p) => privacyPageSelector(p) || termsPageSelector(p)
);

const termsPage = pageCollection.filter(termsPageSelector)[0];
const privacyPage = pageCollection.filter(privacyPageSelector)[0];
const privacyPagePath = privacyPage ? getPagePath(privacyPage) : '';
const termsPagePagePath = termsPage ? getPagePath(termsPage) : '';
---

<footer
  class="mt-16 grid grid-cols-1 gap-8 bg-gray-100 p-10 text-gray-600 sm:grid-cols-3 dark:bg-gray-950 dark:text-gray-400"
>
  <div class="flex flex-col gap-5">
    <Logo class="max-h-12" />
    <div class="flex justify-evenly gap-2">
      {
        links.map(({ text, links = [] }) => (
          <div class="flex w-full flex-col gap-1">
            <h4 class="w-full text-xl font-bold">{text}</h4>
            {links.map(({ href, text }) => (
              <a class="text-lg" href={href.toLowerCase()}>
                {text}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid grid-cols-4 gap-4 self-start sm:grid-cols-3">
    <Text as="strong" class="col-span-full" size="xlarge" weight="bold"
      >{t('Footer.TourRegionsTitle', language)}</Text
    >
    {
      regions.map((region) => (
        <TourRegionsCard
          region={region}
          language={language}
          layout="overlay"
          imageWidths={[200]}
        />
      ))
    }
  </div>
  <Stack layout="vertical" spacing="small">
    <FooterContact language={language} />
  </Stack>
  <div class="col-span-full flex flex-col sm:flex-row">
    <div class="flex flex-1 flex-col gap-2">
      <span class="text-sm font-bold">{t('Footer.PaymentTitle', language)}</span
      >
      <span class="text-xs">{t('Footer.PaymentDescription', language)}</span>
      <div class="flex gap-2">
        <i class="icon-[logos--mastercard] h-8 w-8"></i><i
          class="icon-[logos--visa] h-8 w-8"></i><i
          class="icon-[logos--amex] h-8 w-8"></i><i
          class="icon-[logos--jcb] h-8 w-8"></i>
      </div>
    </div>
    <div class="flex-1">
      <Image src={BARRA_LOGOS_03} alt="PRR" />
    </div>
  </div>
</footer>
<ul
  class="flex w-full flex-wrap justify-center gap-1 bg-gray-50 p-3 dark:bg-gray-800 dark:text-gray-400"
>
  <li>
    @Top Bike Tours Portugal {year}
  </li>
  <li aria-hidden="true">-</li>
  <li>
    <a href={termsPagePagePath}>{t('TermsAndConditions', language)}</a>
  </li>
  <li aria-hidden="true">-</li>
  <li>
    <a href={privacyPagePath} title={t('PrivacyPolicy', language)}
      >{t('PrivacyPolicy', language)}</a
    >
  </li>
</ul>
