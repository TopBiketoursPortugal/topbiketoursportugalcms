---
import Layout from './Layout.astro';
import PostSummary from '../components/blog/summary.astro';
import { getCollection } from 'astro:content';
import type { MarkdownLayoutProps } from 'astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { InferEntrySchema } from 'astro:content';
import type { HrefLang } from 'src/types/hreflang';
import type { BreadcrumbItem } from 'utils/breadcrumbs';
import LanguageData from 'src/../data/languages.json';
import Prose from 'src/components/typography/prose.astro';
import BlogPostingSchema from 'src/components/schema/blog-posting-schema.astro';
import type { LanguageCodes } from 'src/schemas/language';
import { getBlogPermalink } from 'utils/permalinks';

function isMarkdown(props: any): props is MarkdownLayoutProps<PostProps> {
  return props?.rawContent;
}

type PostProps = InferEntrySchema<'blog'> & { hrefs?: ReadonlyArray<HrefLang>; breadcrumbs?: BreadcrumbItem[] };

type Props = (PostProps & { body?: string }) | MarkdownLayoutProps<PostProps>;

const props =
  'frontmatter' in Astro.props ? Astro.props.frontmatter : Astro.props;
const content = isMarkdown(Astro.props)
  ? Astro.props.rawContent()
  : Astro.props.body;

const { title, date, author, hrefs = [], relatedPosts = [], breadcrumbs = [] } = props;
const { src, alt } = props.image;
const wordCount = content?.split(' ')?.length ?? 0;
const readingTime = Math.floor(wordCount / 183);
const dateObj = new Date(date);
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const postUrl = getBlogPermalink({ data: props } as any);

const filterdRelatedPosts = await getCollection(
  'blog',
  (post) =>
    post.data.language === language &&
    post.data.title !== title &&
    relatedPosts.includes(post.data.id)
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,avif,webp}',
  { eager: true }
);

const imageSrc = images[src]?.default ?? src;
const defaultLocale = LanguageData.en;
const defaultHref = hrefs.filter((h) => h.hreflang === defaultLocale.code)[0];
---

<Layout {...props} breadcrumbs={breadcrumbs}>
  <slot name="head" slot="head">
    {
      defaultHref ? (
        <link rel="alternate" href={defaultHref.href} hreflang="x-default" />
      ) : null
    }
    {
      hrefs.map(({ href, hreflang }) => (
        <link
          rel="alternate"
          href={href}
          hreflang={LanguageData[hreflang].locale}
        />
      ))
    }
    <BlogPostingSchema
      title={title}
      date={date}
      author={author}
      image={src}
      wordCount={wordCount}
      language={language}
      url={postUrl}
    />
  </slot>
  <main class="px-8 py-12 md:py-24">
    <article class="mx-auto max-w-3xl">
      <Image
        class="aspect-video rounded-lg"
        src={imageSrc}
        alt={alt ?? 'Post'}
        loading="lazy"
      />
      <h1
        class="py-4 text-3xl font-semibold sm:text-4xl md:text-5xl lg:text-6xl"
      >
        {title}
      </h1>
      <div
        class="flex flex-col justify-between py-5 text-sm font-light sm:gap-5"
      >
        <p class="post-data-list-item">
          {author}
        </p>

        <p class="post-data-list-item">
          {
            dateObj.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })
          }
        </p>

        <div class="flex gap-3">
          <p>{wordCount}<span> words</span></p>
          <p>{readingTime}<span> minutes</span></p>
        </div>
      </div>
      <Prose class="markdown-text" data-cms-edit="content">
        <slot />
      </Prose>
    </article>
    {
      filterdRelatedPosts.length > 0 ? (
        <section class="mx-auto flex max-w-3xl flex-col items-center pt-12">
          <h2 class="text-2xl">Recent Posts</h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2">
            {filterdRelatedPosts.slice(0, 2).map((post) => (
              <div class="max-w-105">
                <PostSummary {...post} />
              </div>
            ))}
          </div>
        </section>
      ) : null
    }
  </main>
</Layout>
