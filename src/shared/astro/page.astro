---
import type { VisuallyEditable } from 'src/types';
import { pascalToKebab } from '../../components/utils/pascalToKebab';

type SharePageProps = {
  contentBlocks: any[];
};

type Props = SharePageProps & VisuallyEditable;

// Component map keyed by kebab path with the filename collapsed when it
// matches its folder (hero/hero.astro → "hero", page-sections/heroes/
// hero-split/HeroSplit.astro → "page-sections/heroes/hero-split"). Must stay
// in sync with registerComponents.ts and renderBlock.astro so `_component`
// resolves identically in builds and in the Visual Editor.
const components: Record<string, Function> = {};
const componentImports = import.meta.glob('../../components/**/*.{jsx,astro}', {
  eager: true
});
Object.entries(componentImports).forEach(([path, obj]) => {
  const parts = path.replace('../../components/', '').split('.')[0].split('/');
  const kebabFilename = pascalToKebab(parts[parts.length - 1]);
  if (parts.length > 1 && kebabFilename === pascalToKebab(parts[parts.length - 2])) {
    parts.pop();
  } else {
    parts[parts.length - 1] = kebabFilename;
  }
  components[parts.join('/')] = (obj as any).default;
});

const { contentBlocks } = Astro.props;

/**
 * Per-block presentation props, settable in the CMS on any content block:
 *   enter:   fade | slide-up | slide-left | slide-right | zoom | wipe | blur | none
 *   surface: default | sand | soft | forest | white
 *
 * Every block animates on enter. Where the browser supports CSS
 * scroll-driven animations (animation-timeline: view()), each block scrubs
 * from hidden to visible as it scrolls into view (see global.css
 * `.block-enter`); otherwise it falls back to the intersection-observer
 * reveal. Blocks that animate their own children get a gentle opacity-only
 * `fade` so the wrapper entrance never fights their internal transforms; the
 * first block (typically the above-the-fold hero) is left untouched. All
 * other blocks cycle through a varied set so consecutive sections enter
 * differently with no content changes — and any block can override via `enter`.
 *
 * Setting `enter: none` explicitly in the CMS is the per-block off switch: it
 * drops the wrapper entrance AND silences every internal reveal/stagger inside
 * that block (via the `.anim-off` class below), so a single prop fully disables
 * a block's scroll animations. (All motion is also globally disabled for users
 * with `prefers-reduced-motion`, handled in global.css.)
 */
const ENTER_CLASS: Record<string, string> = {
  'fade': 'reveal',
  'slide-up': 'reveal-up',
  'slide-left': 'reveal-left',
  'slide-right': 'reveal-right',
  'zoom': 'reveal-zoom',
  'wipe': 'reveal-wipe',
  'blur': 'reveal-blur',
  'none': ''
};

// Deliberate per-type entrances. Most content blocks share one refined
// slide-up so the page reads with a single, consistent cadence; the few
// exceptions are chosen to suit the block, not for novelty.
const BLOCK_ENTER: Record<string, string> = {
  // Self-animating blocks already move their own children, so the wrapper
  // only adds a soft opacity fade that won't fight those internal transforms.
  'page-sections/heroes/hero': 'fade',
  'page-sections/left-right': 'fade',
  'page-sections/featured-tours': 'fade',
  'page-sections/featured-testimonials': 'fade',
  'page-sections/featured-posts': 'fade',
  'page-sections/two-column-markdown': 'fade',
  'building-blocks/testimonials': 'fade',
  'page-sections/collection': 'fade',
  'page-sections/timeline': 'fade',
  'building-blocks/item-grid': 'fade',
  'page-sections/features': 'fade',
  // A photo wall reads beautifully easing up from a hair of scale.
  'page-sections/gallery': 'zoom'
};

const SURFACES = new Set(['sand', 'soft', 'forest', 'white']);

function resolveEnter(block: any, index: number): string {
  if (block.enter && block.enter in ENTER_CLASS) return block.enter;
  // First block is usually the above-the-fold hero — leave it un-wrapped so
  // it paints immediately with no entrance.
  if (index === 0) return 'none';
  // Everything else rises gently into place — one cohesive motion language.
  return BLOCK_ENTER[block._component || block._type || block._bookshop_name] ?? 'slide-up';
}

function resolveSurface(block: any): string | null {
  return SURFACES.has(block.surface) ? block.surface : null;
}

function resolveBleed(block: any, surface: string | null): boolean {
  if (typeof block.bleed === 'boolean') return block.bleed;
  return surface !== null;
}
---

{
  contentBlocks.map((block, i) => {
    // `_component` is the current discriminator (starter convention);
    // `_type`/`_bookshop_name` are accepted for not-yet-migrated content.
    const typeName = block._component || block._type || block._bookshop_name;
    const Component = components[typeName];
    if (!Component) return null;
    const enter = resolveEnter(block, i);
    const enterClass = ENTER_CLASS[enter];
    // An explicit `enter: none` (not the index-0 default) is a deliberate
    // request to turn this block's motion off — also kill its inner reveals.
    const animOff = block.enter === 'none';
    const surface = resolveSurface(block);
    const bleed = resolveBleed(block, surface);
    const content = (
      <div
        class:list={[
          enterClass,
          enterClass && 'block-enter intersect:opacity-100 intersect-once',
          animOff && 'anim-off',
          surface && `surface-${surface}`,
          { 'dark': surface === 'forest', 'block-bleed': bleed }
        ]}
      >
        <Component {...block} />
      </div>
    );
    
    // Wrap with editable-component for CloudCannon visual editing
    return (
      <editable-component data-component={typeName} data-prop={`content_blocks[${i}]`}>
        {content}
      </editable-component>
    );
  })
}
