---
import { v7 as uuidv7 } from 'uuid';
import { clsx } from 'clsx';

type Props = {
  title?: string;
  open?: boolean;
  class?: string;
};

const { title, open = true, class: className } = Astro.props;
const id = `accordion-${(title ?? uuidv7()).toLowerCase().replace(/\s+/g, '-')}`;
---

<details
  open={open}
  class={clsx(
    'group overflow-hidden border border-gray-200 dark:border-gray-900',
    className
  )}
  id={id}
>
  <summary
    class="w-full cursor-pointer list-none [&::-webkit-details-marker]:hidden"
    aria-controls={`${id}-content`}
    aria-expanded="false"
  >
    <slot name="header">
      <div
        class="flex w-full items-center justify-between bg-gray-100 p-4 transition-all duration-200 ease-in-out hover:bg-gray-200 dark:bg-neutral-900"
      >
        <span class="font-medium">{title}</span>
        <svg
          class="h-5 w-5 transform transition-transform duration-300 ease-in-out group-open:rotate-180 hover:bg-slate-200 dark:hover:bg-neutral-800"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </slot>
  </summary>
  <div
    id={`${id}-content`}
    class="max-h-0 origin-top scale-y-95 transform bg-white opacity-0 transition-all duration-500 ease-in-out group-open:max-h-200 group-open:scale-y-100 group-open:opacity-100 dark:bg-black"
    role="region"
    aria-labelledby={`${id}-heading`}
  >
    <div class="p-4">
      <slot />
    </div>
  </div>
</details>
