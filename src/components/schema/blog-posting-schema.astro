---
import SiteData from 'src/../data/site.json';
import type { LanguageCodes } from 'src/schemas/language';
import { resolveSchemaImage } from 'utils/schema-image';

type Props = {
  title: string;
  date: string | Date;
  author?: string | null;
  image?: string;
  wordCount?: number;
  language: LanguageCodes;
  url: string;
};

const { title, date, author, image, wordCount, language, url } = Astro.props;
const site = SiteData[language];
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const imageUrl = await resolveSchemaImage(image, Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'datePublished': new Date(date).toISOString(),
  'url': `${baseUrl}${url}`,
  ...(author ? { author: { '@type': 'Person', 'name': author } } : {}),
  ...(imageUrl ? { image: imageUrl } : {}),
  ...(wordCount ? { wordCount } : {}),
  'publisher': {
    '@type': 'Organization',
    '@id': `${site.site.url}#organization`,
    'name': site.site.name
  }
};
---

<script
  is:inline
  async
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
