---
import Price from 'src/components/building-blocks/price/price.astro';
import type { LanguageCodes } from 'src/schemas/language';

type Props = {
  title: string;
  /**
   * Amount in the currency of record (euros), not a formatted string: the
   * column has to render every supported currency so the switcher can reveal
   * one, which only <Price> can do. `0`/undefined means "no price here" —
   * the seasons and add-ons tables pass nothing.
   */
  price?: number;
  promo?: number;
  currency?: string;
  language?: LanguageCodes;
  period?: string;
  popular?: boolean;
  bestValue?: boolean;
  showPrice?: boolean;
};

const {
  title,
  price = 0,
  promo = 0,
  currency = 'EUR',
  language = 'en',
  period = '',
  popular = false,
  bestValue = false,
  showPrice = true
} = Astro.props;
---

<div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md dark:border-gray-700 dark:bg-gray-900">
  {(popular || bestValue) && (
    <span
      class:list={[
        'absolute -top-3 right-4 rounded-full px-3 py-1 text-xs font-semibold tracking-wide text-white',
        popular ? 'bg-accent' : 'bg-primary'
      ]}
    >
      {popular ? 'POPULAR' : 'BEST VALUE'}
    </span>
  )}

  <div class="mb-4 border-b border-gray-100 pb-4 text-center dark:border-gray-800">
    <h4 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">
      {title}
    </h4>
    {showPrice && price ? (
      <div class="mt-2 flex items-baseline justify-center gap-2">
        {promo ? (
          <Price
            amount={price}
            currency={currency}
            language={language}
            class="text-lg text-gray-400 line-through"
          />
        ) : null}
        <Price
          amount={promo || price}
          currency={currency}
          language={language}
          class="text-2xl font-bold text-gray-900 dark:text-white"
        />
      </div>
    ) : null}
    {period ? (
      <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400">
        {period}
      </span>
    ) : null}
    <slot name="action" />
  </div>

  <div class="flex flex-col">
    <slot />
  </div>
</div>
