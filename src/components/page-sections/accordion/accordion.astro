---
import {
  Container,
  type ContainerProps
} from 'src/components/building-blocks/container';
import Prose from 'src/components/building-blocks/typography/prose.astro';
import AccordionItem from './accordion-item.astro';

export type AccordionItemProps = {
  header?: { text?: string };
  content?: string;
};

export type AccordionProps = {
  container?: ContainerProps['size'];
  padding?: ContainerProps['padding'];
  expansionType?: 'plus' | 'arrow';
  type?: 'faq';
  items?: AccordionItemProps[];
};

type Props = AccordionProps;

/**
 * Flatten an authored answer to the plain text that goes in the `FAQPage`
 * JSON-LD. Google compares the marked-up answer against the rendered one, so
 * this has to strip markdown *syntax* and leave every ordinary character
 * alone.
 *
 * The previous version deleted the characters `* _ ~ \` > # -` wherever they
 * appeared, which mangled real words on the way through: "self-guided" became
 * "selfguided", "mid-to-high teens" became "midtohigh teens", "Easy to
 * moderate (2/5)" survived but "e-bike" did not. Every hyphenated term on
 * these pages — and there are a lot, starting with the target keyword
 * "self-guided bike tours" — was being published to Google as a typo.
 */
function markdownToText(md: string) {
  return md
    .replace(/!\[.*?\]\(.*?\)/g, '') // images
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // links, keeping the anchor text
    .replace(/`([^`]*)`/g, '$1') // inline code
    .replace(/(\*\*\*|___)(\S[\s\S]*?\S|\S)\1/g, '$2') // bold italic
    .replace(/(\*\*|__)(\S[\s\S]*?\S|\S)\1/g, '$2') // bold
    .replace(/(\*|_)(\S[\s\S]*?\S|\S)\1/g, '$2') // italic
    .replace(/~~(\S[\s\S]*?\S|\S)~~/g, '$1') // strikethrough
    .replace(/^\s{0,3}#{1,6}\s+/gm, '') // ATX headings
    .replace(/^\s{0,3}>\s?/gm, '') // blockquote markers
    .replace(/^\s{0,3}[-*+]\s+/gm, '') // bullet markers
    .replace(/^\s{0,3}\d+\.\s+/gm, '') // ordered-list markers
    .replace(/\s+/g, ' ') // collapse all whitespace, newlines included
    .trim();
}

const {
  items = [],
  container = 'full',
  padding = 'none',
  type = ''
} = Astro.props;
// A Question with an empty `name` or an empty answer is invalid, and one bad
// entry invalidates the whole FAQPage — so pairs that are not complete are
// dropped rather than emitted blank.
const faqEntries =
  type === 'faq'
    ? items
        .map((i) => ({
          question: markdownToText(i.header?.text ?? ''),
          answer: markdownToText(i.content ?? '')
        }))
        .filter((i) => i.question.length > 0 && i.answer.length > 0)
    : [];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqEntries.map((i) => ({
    '@type': 'Question',
    'name': i.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': i.answer
    }
  }))
};
---

{faqEntries.length > 0 && (
  <script
    is:inline
    async
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
)}
<Container size={container} padding={padding}>
  <div
    role="group"
    aria-label="Accordion"
    class="accordion flex flex-col gap-2"
  >
    <slot>
      {items.map(({ header, content }) => (
        <AccordionItem open class="border-none">
          <div slot="header" class="flex w-full items-center gap-4">
            <div class="box-content flex border-collapse items-center justify-center border-gray-600 bg-slate-100 p-4 hover:bg-slate-400">
              <svg
                class="h-5 w-5 transition-transform duration-300 ease-in-out"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  class="vertical-line group-open:hidden"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16"
                />
                <path
                  class="horizontal-line"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 12h16"
                />
              </svg>
            </div>
            <Prose markdown={header?.text} />
          </div>
          <div class="pl-4">
            <Container size="full" padding={padding}>
              <Prose markdown={content} />
            </Container>
          </div>
        </AccordionItem>
      ))}
    </slot>
  </div>
</Container>
