---
import Prose from 'src/components/building-blocks/typography/prose.astro';

type Props = {
  type:
    | 'tours'
    | 'tour-regions'
    | 'tours-package-tour'
    | 'tours-day-tour'
    | 'reviews'
    | 'team'
    | 'bikes'
    | 'posts'
    | 'tour-tags'
    | 'tour-rider-levels';
  display: 'slideshow' | 'list';
  contentDisplay: 'overlay' | 'inline';
  frame: 'none' | 'light' | 'heavy';
  layout: 'horizontal' | 'vertical' | 'overlay' | 'hstack';
  title: string;
  heading: { text: string };
};

const collectionComponentImports = import.meta.glob(
  '/src/components/page-sections/collection/**/*-collection.astro',
  {
    eager: true
  }
);

// `heading` was declared on the collection components but rendered by none of
// them, so every authored value was dropped at build time — 24 of them across
// six locales, including the `## Find our popular tours` on /day-tours/. It is
// handled here rather than per-collection so all ten types behave the same.
// Authors write this field two ways: `## Heading` (day-tours, bike-hollidays)
// and bare text (about-us), so it goes through Prose like `title` does — the
// first renders an h2, the second a paragraph.
const { type = 'tours', title, heading, ...data } = Astro.props;

const componentName = `/src/components/page-sections/collection/${type}-collection.astro`;
const CollectionComponent = (collectionComponentImports[componentName] as any)
  ?.default;
---

<div class="flex flex-col gap-3 px-3 py-1 sm:gap-4 sm:py-3">
  {title ? (
    <div data-editable="text" data-type="block" data-prop="title">
      <Prose markdown={title} />
    </div>
  ) : null}
  {heading?.text ? (
    <div data-editable="text" data-type="block" data-prop="heading.text">
      <Prose markdown={heading.text} />
    </div>
  ) : null}
  <CollectionComponent {...data} />
</div>
