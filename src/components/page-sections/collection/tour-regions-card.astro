---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import { getTourRegionsPath } from 'utils/permalinks';
import ResponsiveImage from 'src/components/building-blocks/responsive-image/ResponsiveImage.astro';

export type TourRegionCardProps = {
  region: CollectionEntry<'tourRegions'>;
  language: LanguageCodes;
  layout?: 'overlay' | 'hstack';
  imageWidths?: number[];
};

type Props = TourRegionCardProps;

const {
  region,
  language,
  layout = 'overlay',
  // The overlay grid runs 2 / 3 / 4 columns, so a card is ~300px wide at the
  // widest breakpoint — 600px once a retina screen is in play. The old
  // 200–300px ceiling meant these were always upscaled.
  imageWidths = [300, 600, 900]
} = Astro.props;

// Matches the collection's 2 / 3 / 4 column grid.
const overlaySizes = '(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 25vw';
const { data } = region;
const { title, name, seo } = data;
const regionPath = getTourRegionsPath(region, language);
---

{
  layout === 'overlay' ? (
    <a
      href={regionPath}
      class="group zoom-frame relative block rounded-xl shadow-md shadow-slate-900/10"
    >
      {seo?.featured_image ? (
        <ResponsiveImage
          src={seo?.featured_image}
          alt={seo?.featured_image_alt ?? title}
          widths={imageWidths}
          sizes={overlaySizes}
          paralax={false}
        />
      ) : null}
      <span
        class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"
        aria-hidden="true"
      />
      {/* A heading, like the hstack variant — the region name is the card's
          title, and a bare <span> left this grid absent from the outline. */}
      <h3 class="font-heading absolute inset-x-0 bottom-0 p-3 text-center text-lg font-bold text-white capitalize drop-shadow-sm transition-transform duration-300 group-hover:-translate-y-1">
        {name}
      </h3>
    </a>
  ) : (
    <a
      href={regionPath}
      class="group flex items-center gap-4 rounded-lg border border-gray-200 bg-white p-3 transition-all hover:shadow-lg dark:border-gray-700 dark:bg-gray-900 dark:hover:border-gray-600"
    >
      {seo?.featured_image ? (
        <div class="zoom-frame h-16 w-16 shrink-0 rounded-md">
          <ResponsiveImage
            src={seo?.featured_image}
            alt={seo?.featured_image_alt ?? title}
            widths={[64, 128, 192]}
            sizes="64px"
            paralax={false}
            class="h-full w-full object-cover"
          />
        </div>
      ) : null}
      <h3 class="text-lg font-semibold text-gray-900 capitalize dark:text-gray-100">
        {name}
      </h3>
    </a>
  )
}
