---
import { getCollection } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import TourTagsCard from './tour-tags-card.astro';
import Stack from 'src/components/building-blocks/stack/stack.astro';
import Heading from 'src/components/building-blocks/typography/heading.astro';

export type TourTagsCollectionProps = {
  layout?: 'overlay' | 'hstack';
  title?: string;
  imageWidths?: number[];
};

type Props = TourTagsCollectionProps;

const { title, imageWidths = [300] } = Astro.props;
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;

const tags = await getCollection(
  'tourTags',
  (t) => t.data.language === language
);

const tours = await getCollection(
  'tours',
  (t) => t.data.language === language
);

const tagCounts = new Map<string, number>();
for (const tag of tags) {
  const count = tours.filter((t) => (t.data.tags ?? []).includes(tag.data.id)).length;
  tagCounts.set(tag.data.id, count);
}

const visibleTags = tags.filter((t) => (tagCounts.get(t.data.id) ?? 0) > 0);
---

<Stack layout="vertical" spacing="large" class="w-full">
  {
    title ? (
      <Heading as="h2" class="px-6">
        {title}
      </Heading>
    ) : null
  }

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {
      visibleTags.map((tag) => (
        <TourTagsCard
          tag={tag}
          language={language}
          tourCount={tagCounts.get(tag.data.id) ?? 0}
          imageWidths={imageWidths}
        />
      ))
    }
  </div>
</Stack>
