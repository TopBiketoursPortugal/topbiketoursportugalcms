---
import { getCollection } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import TourRiderLevelsCard from './tour-rider-levels-card.astro';
import Stack from 'src/components/building-blocks/stack/stack.astro';
import Heading from 'src/components/building-blocks/typography/heading.astro';

export type TourRiderLevelsCollectionProps = {
  layout?: 'overlay' | 'hstack';
  title?: string;
  imageWidths?: number[];
};

type Props = TourRiderLevelsCollectionProps;

const { title, imageWidths = [400] } = Astro.props;
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;

const levels = await getCollection(
  'tourRiderLevels',
  (t) => t.data.language === language
);

const tours = await getCollection(
  'tours',
  (t) => t.data.language === language
);

const levelCounts = new Map<string, number>();
for (const level of levels) {
  const count = tours.filter((t) => (t.data.riderLevels ?? []).includes(level.data.id)).length;
  levelCounts.set(level.data.id, count);
}
---

<Stack layout="vertical" spacing="large" class="w-full">
  {
    title ? (
      <Heading as="h2" class="px-6">
        {title}
      </Heading>
    ) : null
  }

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    {
      levels.map((level) => (
        <TourRiderLevelsCard
          level={level}
          language={language}
          tourCount={levelCounts.get(level.data.id) ?? 0}
          imageWidths={imageWidths}
        />
      ))
    }
  </div>
</Stack>
