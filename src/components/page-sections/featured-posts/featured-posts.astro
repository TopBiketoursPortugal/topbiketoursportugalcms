---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { VisuallyEditable } from 'src/types';
import {
  getBlogPermalink,
  getBlogTagPath,
  getGuidePath
} from 'utils/permalinks';
import { resolveImageSrc } from 'utils/get-image';
import type { LanguageCodes } from 'src/schemas/language';
import type { FeaturedPost } from 'src/content.config';

type Props = FeaturedPost & VisuallyEditable;

/**
 * One shape for both sources so the markup below does not care whether it is
 * showing posts or guides. `collection` picks which id fields are read.
 */
type Feature = {
  id: string;
  title: string;
  url: string;
  date: Date;
  thumb: string;
  thumbAlt: string;
  tags: string[];
};

const block = Astro.props;
const source = block.collection === 'guides' ? 'guides' : 'blog';
const mainId = source === 'guides' ? block.main_guide : block.main_feature;
const listIds =
  (source === 'guides' ? block.guide_list : block.feature_list) ?? [];
const language = (Astro.currentLocale ?? 'en') as LanguageCodes;

const wanted = (id: string) => mainId === id || listIds.includes(id);

const features: Feature[] =
  source === 'guides'
    ? (
        await getCollection(
          'guides',
          (g) => g.data.language === language && wanted(g.data.id)
        )
      ).map((g) => ({
        id: g.data.id,
        title: g.data.title,
        url: getGuidePath(g),
        date: new Date(g.data.updated ?? g.data.date),
        thumb: g.data.thumb_image_path,
        thumbAlt: g.data.thumb_image_alt,
        tags: g.data.tags ?? []
      }))
    : (
        await getCollection(
          'blog',
          (p) => p.data.language === language && wanted(p.data.id)
        )
      ).map((p) => ({
        id: p.data.id,
        title: p.data.title,
        url: getBlogPermalink(p),
        date: new Date(p.data.date),
        thumb: p.data.thumb_image_path,
        thumbAlt: p.data.thumb_image_alt,
        tags: p.data.tags ?? []
      }));

const mainFeature = features.find((f) => f.id === mainId);
const listFeatures = features
  .filter((f) => f.id !== mainId && listIds.includes(f.id))
  .sort((a, b) => listIds.indexOf(a.id) - listIds.indexOf(b.id));

const allPostTags = await getCollection(
  'postTags',
  (t) => t.data.language === language
);
const tagMap = new Map(allPostTags.map((t) => [t.data.id, t]));

const uniqueThumbPaths = [...new Set(features.map((f) => f.thumb))];
const thumbImageMap = new Map(
  await Promise.all(
    uniqueThumbPaths.map(
      async (path) => [path, await resolveImageSrc(path)] as const
    )
  )
);

const dateTimeFormatter = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'America/Chicago'
});

const tagsOf = (feature: Feature) =>
  feature.tags.map((id) => tagMap.get(id)).filter(Boolean);
---

<section
  class="reveal-stagger intersect:opacity-100 intersect-once mx-auto flex max-w-7xl flex-col gap-6 px-12 py-12 lg:flex-row"
>
  {
    mainFeature ? (
      <div class="lg:w-3/4">
        <a
          href={mainFeature.url}
          class="zoom-frame block rounded-xl shadow-md shadow-slate-900/10"
        >
          <Image
            class="aspect-video w-full rounded-xl object-cover"
            alt={mainFeature.thumbAlt ?? 'Top Bike Tours Portugal'}
            widths={[320, 500, 640, 960, 1280]}
            sizes={`(max-width: 320px) 320px, (max-width: 500px) 500px, (max-width: 640px) 640px, (max-width: 960px) 960px, 1280px`}
            src={thumbImageMap.get(mainFeature.thumb) as any}
          />
        </a>
        {tagsOf(mainFeature).length > 0 ? (
          <div class="flex flex-col gap-3 pt-3 sm:flex-row">
            {tagsOf(mainFeature).map((tag) => (
              <a href={getBlogTagPath(tag!, language)}>
                <span class="rounded-sm bg-slate-200 px-2 py-1 dark:bg-slate-800">
                  {tag!.data.name ?? tag!.data.title}
                </span>
              </a>
            ))}
          </div>
        ) : null}
        <a href={mainFeature.url}>
          <h3 class="py-2 text-3xl font-semibold">{mainFeature.title}</h3>
        </a>
        <p>{dateTimeFormatter.format(mainFeature.date)}</p>
      </div>
    ) : null
  }
  <div
    class="non-featured-posts mx-auto flex flex-col gap-3 md:flex-row lg:w-1/4 lg:flex-col"
  >
    {
      listFeatures.map((feature) => (
        <div>
          <a
            href={feature.url}
            class="zoom-frame block rounded-xl shadow-md shadow-slate-900/10"
          >
            <Image
              class="aspect-video w-full rounded-xl object-cover"
              alt={
                feature.thumbAlt ?? 'Top Bike Tours Portugal thumb_image_alt'
              }
              widths={[320, 500, 640]}
              sizes={`(max-width: 320px) 320px, (max-width: 500px) 500px, 640px`}
              src={thumbImageMap.get(feature.thumb) as any}
            />
          </a>
          <div>
            {tagsOf(feature).length > 0 ? (
              <div class="flex flex-col gap-3 pt-3 sm:flex-row">
                {tagsOf(feature).map((tag) => (
                  <a href={getBlogTagPath(tag!, language)}>
                    <span class="rounded-sm bg-slate-200 px-2 py-1 dark:bg-slate-800">
                      {tag!.data.name ?? tag!.data.title}
                    </span>
                  </a>
                ))}
              </div>
            ) : null}
            <a href={feature.url}>
              <h3 class="py-1 text-2xl font-semibold">{feature.title}</h3>
            </a>
            <p>{dateTimeFormatter.format(feature.date)}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
