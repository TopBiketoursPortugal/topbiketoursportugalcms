---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getBlogPermalink } from 'utils/permalinks';

type Props = CollectionEntry<'blog'>;

const { data } = Astro.props;
const { thumb_image_path, thumb_image_alt, title, date } = data;

const dateObj = new Date(date);
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,avif,webp}',
  { eager: true }
);
const imageSrc = images[thumb_image_path]?.default ?? thumb_image_path;
---

<a href={getBlogPermalink(Astro.props)} class="sidebar-post group flex gap-3">
  <Image
    class="aspect-video w-20 shrink-0 rounded-sm object-cover"
    src={imageSrc}
    alt={thumb_image_alt ?? title}
    width={160}
    loading="lazy"
  />
  <div class="flex flex-col">
    <p class="text-sm font-medium leading-snug group-hover:underline">{title}</p>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      {dateObj.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>
  </div>
</a>
