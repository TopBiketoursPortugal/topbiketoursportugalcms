---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import { getBikeCategoryPath } from 'utils/permalinks';
import { getTagIconClass } from 'src/utils/tag-icon-safelist';

export type BikeCategoryCardProps = {
  category: CollectionEntry<'bikeCategories'>;
  language: LanguageCodes;
  tourCount?: number;
};

type Props = BikeCategoryCardProps;

const { category, language, tourCount } = Astro.props;
const { data } = category;
const { title, name, icon } = data;
const categoryPath = getBikeCategoryPath(category, language);
const iconClass = getTagIconClass(icon);
const displayName = name ?? title;
---

<a
  href={categoryPath}
  class="bike-category-card group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white transition-all hover:shadow-lg dark:border-gray-700 dark:bg-gray-900 dark:hover:border-gray-600"
>
  <div class="flex items-center gap-3 p-5">
    <i class:list={[iconClass, 'h-7 w-7 text-amber-600 dark:text-amber-400']} aria-hidden="true" />
    <span class="text-xl font-bold text-gray-900 dark:text-gray-100">{displayName}</span>
  </div>
  {tourCount !== undefined && (
    <div class="px-4 py-2 text-sm text-gray-500 dark:text-gray-400">
      {tourCount} {tourCount === 1 ? 'tour' : 'tours'}
    </div>
  )}
</a>
