---
/** @jsxImportSource astro */
import 'src/safelist-icons.ts';
import { Image } from 'astro:assets';
import Rating from 'src/components/rating/rating.astro';
import { getImageByPath } from 'utils/get-image';
import Prose from '../typography/prose.astro';
import { getCountryCode } from 'utils/get-country-code';
import { cn } from '@utils/cn';

type Props = {
  name?: string;
  country?: string;
  content: string;
  rating: number;
  photo?: string;
  expand_behavior?: 'hover' | 'button' | 'none';
};

const {
  name,
  country,
  content,
  rating,
  photo,
  expand_behavior = 'hover'
} = Astro.props;
const imageOptimized = photo
  ? (getImageByPath(photo) satisfies Promise<{
      default: ImageMetadata;
    }>)
  : null;

const countryCode = getCountryCode(country ?? '');

const countryFlagIcon = countryCode
  ? `icon-[circle-flags--${countryCode.toLowerCase()}]`
  : 'icon-[ph--user-circle-light]';

const uniqueId = `review-expand-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="flex flex-col gap-6">
  <div class="flex justify-center">
    {
      imageOptimized ? (
        <Image
          src={imageOptimized}
          widths={[320, 500, 640]}
          sizes={`(max-width: 640px) 320px, (max-width: 960px) 500px, 640px`}
          fetchpriority="auto"
          decoding="async"
          loading="lazy"
          alt={name ?? country ?? 'Review Top waling tours portugal'}
          class="w-32 rounded-[100%] shadow-lg dark:shadow-black/30"
        />
      ) : (
        <i class={cn('mb-6 h-12 w-12', countryFlagIcon)} />
      )
    }
  </div>
  <p class="text-xl font-semibold">{name} - {country}</p>
  {
    expand_behavior === 'button' ? (
      <>
        <input type="checkbox" id={uniqueId} class="peer hidden" />
        <span class="inline text-neutral-600 dark:text-neutral-300">
          <i class="icon-[ph--quotes-fill]" />
          <div class="truncate-text">
            <Prose markdown={content} />
          </div>
        </span>
        <label
          for={uniqueId}
          class="text-primary-600 dark:text-primary-400 cursor-pointer font-bold hover:underline"
        >
          <span class="inline peer-checked:hidden">Read more</span>
          <span class="hidden peer-checked:inline">Read less</span>
        </label>
      </>
    ) : (
      <span class="inline text-neutral-600 dark:text-neutral-300">
        <i class="icon-[ph--quotes-fill]" />
        <div
          class={cn(
            'truncate-text',
            expand_behavior === 'hover' && 'expand-hover'
          )}
        >
          <Prose markdown={content} />
        </div>
      </span>
    )
  }
  <Rating rating={rating} />
</div>

<style is:global>
  .truncate-text p {
    display: -webkit-box;
    -webkit-line-clamp: 5; /* Limits text to 5 lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.5; /* Consistent line height for predictability */
    max-height: calc(1.5em * 5);
    transition: all 0.8s cubic-bezier(0.33, 0.11, 0.14, 1);
  }
  .truncate-text.expand-hover:hover p {
    max-height: 100vh; /* Use viewport height for smooth animation */
    transition-timing-function: cubic-bezier(0.33, 0.11, 0.14, 1.4);
    overflow: clip;
    text-overflow: unset;
    -webkit-line-clamp: unset;
  }

  /* CSS Hack for Button Expansion */
  input.peer:checked ~ span .truncate-text p {
    max-height: none;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
</style>
