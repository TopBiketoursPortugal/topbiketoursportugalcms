---
import type { CollectionEntry } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import ResponsiveImage from 'src/components/responsive-image/ResponsiveImage.astro';
import { t } from 'utils/i18n';

type Props = {
  bike: CollectionEntry<'bikes'>;
  language: LanguageCodes;
  imageWidths?: number[];
};

const { bike, language, imageWidths = [400] } = Astro.props;
const { title, brand, specs, frameType, infoUrl, image } = bike.data;
---

<div class="group overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
  <div class="relative h-48 w-full overflow-hidden bg-gray-50 dark:bg-gray-800">
    <ResponsiveImage
      src={image.src}
      alt={image.alt}
      widths={imageWidths}
      class="h-full w-full object-contain p-4"
    />
  </div>
  <div class="flex flex-col gap-2 p-4">
    <h4 class="text-lg font-bold text-gray-900 dark:text-gray-100">{title}</h4>
    {brand && <span class="text-sm text-gray-500 dark:text-gray-400">{brand}</span>}
    {specs && <p class="text-sm text-gray-600 dark:text-gray-300">{specs}</p>}
    {frameType && <span class="text-xs text-gray-400 dark:text-gray-500">{frameType}</span>}
    {infoUrl && (
      <a href={infoUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300">
        {t('Bikes.MoreInfo', language)} &rarr;
      </a>
    )}
  </div>
</div>
