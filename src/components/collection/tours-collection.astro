---
import { getCollection } from 'astro:content';
import Grid from 'src/components/grid/grid.astro';
import Stack from 'src/components/stack/stack.astro';
import type { LanguageCodes } from 'src/schemas/language';
import TourListSchema from 'src/components/tours/tour-list-schema.astro';
import TourCard from 'src/components/tours/tour-card.astro';
import TourFilterBar from 'src/components/tours/tour-filter-bar.astro';
import type { TourSchema } from 'src/schemas/tours';
import { t } from 'utils/i18n';
import { getTourPath } from 'utils/permalinks';
import SiteData from 'src/../data/site.json';

export type TourCollectionProps = {
  type: 'tours' | 'reviews' | 'team' | 'bikes' | 'posts';
  display: 'slideshow' | 'list';
  contentDisplay: 'overlay' | 'inline';
  frame: 'none' | 'light' | 'heavy';
  layout: 'horizontal' | 'vertical';
  title: string;
  heading: { text: string };
  tourType?: TourSchema['tourtype'];
};

type Props = TourCollectionProps;

const { contentDisplay = 'inline', tourType } = Astro.props;

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const tours = await getCollection(
  'tours',
  (item) =>
    item.data?.language === language &&
    ((tourType ?? '') === '' || item.data.tourtype === tourType)
);
const items =
  tours.sort((a, b) => (a?.data?.order ?? 0) - (b?.data?.order ?? 0)) ?? [];

const allRegions = await getCollection('tourRegions', (f) => f.data.language === language);
const allRiderLevels = await getCollection('tourRiderLevels', (f) => f.data.language === language);
const allTags = await getCollection('tourTags', (f) => f.data.language === language);
const allBikeCategories = await getCollection('bikeCategories', (f) => f.data.language === language);

const tourRegionIds = new Set(items.map((i) => i.data.region).filter(Boolean));
const tourRiderLevelIds = new Set(items.flatMap((i) => i.data.riderLevels ?? []));
const tourTagIds = new Set(items.flatMap((i) => i.data.tags ?? []));
const tourBikeCategoryIds = new Set(items.flatMap((i) => i.data.bikeCategories ?? []));

const relevantRegions = allRegions.filter((r) => tourRegionIds.has(r.data.id));
const relevantRiderLevels = allRiderLevels.filter((l) => tourRiderLevelIds.has(l.data.id));
const relevantTags = allTags.filter((tg) => tourTagIds.has(tg.data.id));
const relevantBikeCategories = allBikeCategories.filter((c) => tourBikeCategoryIds.has(c.data.id));

const site = SiteData[language];
const baseUrl = Astro.site ?? site.site.url;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'numberOfItems': items.length,
  'itemListElement': items.map(({ data }, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': data.title,
    'url': `${baseUrl}${getTourPath(data, language).replace(/^\//, '')}`
  }))
};
---

<section aria-label={t('Tours.Collection.Label', language)}>
  <div data-tour-filter-container>
    <TourFilterBar
      language={language}
      totalCount={items.length}
      showRegion={relevantRegions.length > 0}
      showRiderLevel={relevantRiderLevels.length > 0}
      showTag={relevantTags.length > 0}
      showBikeCategory={relevantBikeCategories.length > 0}
      regions={relevantRegions.map((r) => ({ id: r.data.id, name: r.data.name ?? r.data.title }))}
      riderLevels={relevantRiderLevels.map((l) => ({ id: l.data.id, name: l.data.name ?? l.data.title }))}
      tags={relevantTags.map((tg) => ({ id: tg.data.id, name: tg.data.name ?? tg.data.title }))}
      bikeCategories={relevantBikeCategories.map((c) => ({ id: c.data.id, name: c.data.name ?? c.data.title }))}
    />

    {items.length > 0 ? (
      <div data-tour-section>
        <Stack class="sm:p-6" layout="vertical">
          <Grid cols={3}>
            {
              items.map(({ data }) => (
                <TourCard
                  tour={data}
                  contentDisplay={contentDisplay}
                  language={language}
                />
              ))
            }
          </Grid>
        </Stack>
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <i class="icon-[ph--map-trifold-light] mb-4 h-12 w-12 text-gray-300 dark:text-gray-600" aria-hidden="true" />
        <p class="text-lg text-gray-500 dark:text-gray-400">
          {t('Tours.Collection.NoResults', language)}
        </p>
      </div>
    )}
  </div>
</section>
<TourListSchema items={items} language={language} />
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(itemListSchema)}
/>
