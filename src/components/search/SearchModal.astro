---
// SearchModal.astro - Site search modal using Popover API
import Search from 'astro-pagefind/components/Search';
---

<div
  id="search-modal"
  popover="auto"
  class="m-auto max-h-screen w-[95vw] max-w-2xl rounded-lg border border-gray-200 bg-white p-0 shadow-2xl md:w-full dark:border-slate-700 dark:bg-slate-900"
>
  <div class="flex flex-col">
    <!-- Header with close button -->
    <div
      class="flex items-center justify-between border-b border-gray-200 p-4 dark:border-slate-700"
    >
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Search
      </h2>
      <button
        popovertarget="search-modal"
        popovertargetaction="hide"
        class="rounded-lg p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-slate-800 dark:hover:text-gray-200"
        aria-label="Close search"
      >
        <i class="icon-[ph--x-light] h-5 w-5" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Search content area -->
    <div class="p-4 dark:bg-slate-900">
      <Search id="search" uiOptions={{ showImages: false }} />
    </div>
  </div>
</div>
