---
import Prose from '../typography/prose.astro';
import { type VariantProps, tv } from 'tailwind-variants';

// Import button components with proper types
import PrimaryButton from '@components/buttons/primary/primary.astro';
import SecondaryButton from '@components/buttons/secondary/secondary.astro';

interface Props extends VariantProps<typeof twoColumnVariants> {
  column1: {
    text: string;
    button?: {
      _bookshop_name: string;
      button_text: string;
      button_icon: string;
      button_link: string;
      background_color?: string;
      hover_brightness: number;
      text_color: string;
    };
  };
  column2: {
    text: string;
    button?: {
      _bookshop_name: string;
      button_text: string;
      button_icon: string;
      button_link: string;
      background_color?: string;
      hover_brightness: number;
      text_color: string;
    };
  };
}

const twoColumnVariants = tv({
  base: 'grid grid-cols-1 gap-8 text-balance md:grid-cols-2',
  variants: {
    padding: {
      contained: 'px-6 py-12 md:px-12 md:py-20',
      tight: 'px-4 py-8 md:px-8 md:py-16',
      normal: 'px-6 py-10 md:px-10 md:py-16'
    },
    fullwidth: {
      true: 'max-w-none',
      false: 'mx-auto max-w-screen-xl'
    }
  },
  defaultVariants: {
    padding: 'normal',
    fullwidth: false
  }
});

const { column1, column2, padding, fullwidth = false } = Astro.props;

// Get button components based on bookshop name
const getButtonComponent = (buttonName: string) => {
  const name = buttonName.split('/').reverse()[0];
  switch (name) {
    case 'primary':
      return PrimaryButton;
    case 'secondary':
      return SecondaryButton;
    default:
      return null;
  }
};

const Button1 = column1?.button
  ? getButtonComponent(column1.button._bookshop_name)
  : null;
const Button2 = column2?.button
  ? getButtonComponent(column2.button._bookshop_name)
  : null;
---

<div class={twoColumnVariants({ padding, fullwidth })}>
  <div
    class="reveal-left intersect:opacity-100 intersect-once flex flex-col gap-4"
  >
    <Prose markdown={column1?.text ?? ''} />
    {column1?.button && Button1 && <Button1 {...column1.button} />}
  </div>
  <div
    class="reveal-right reveal-delay-1 intersect:opacity-100 intersect-once flex flex-col gap-4"
  >
    <Prose markdown={column2?.text ?? ''} />
    {column2?.button && Button2 && <Button2 {...column2.button} />}
  </div>
</div>
