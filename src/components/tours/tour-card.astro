---
import CardMedia from 'src/components/building-blocks/card/CardMedia.astro';
import { getTourPath, getTourTagPath } from 'utils/permalinks';
import CardContent, {
  type CardContentProps
} from 'src/components/building-blocks/card/CardContent.astro';
import Card from 'src/components/building-blocks/card/Card.astro';
import Languages from 'src/../data/languages.json';
import type { LanguageCodes } from 'src/schemas/language';
import { getCollection, type InferEntrySchema } from 'astro:content';
import { getMarkdownExcerpt } from 'utils/get-markdown-excerpt';
import Stack from 'src/components/building-blocks/stack/stack.astro';
import Rating from 'src/components/building-blocks/rating/rating.astro';
import Separator from 'src/components/building-blocks/separator/separator.astro';
import LinkButton from 'src/components/building-blocks/linkbutton/linkbutton.astro';
import { t } from 'utils/i18n';
import { getAggregatedReviews } from 'utils/reviews';
import { MapTestimonialToReview } from 'utils/map-testimonial-to-review';
import WeTravelButton from 'src/components/page-sections/wetravel-button/wetravel-button.astro';

type Props = {
  tour: InferEntrySchema<'tours'>;
  language: LanguageCodes;
  contentDisplay: CardContentProps['display'];
};

const { tour: data, contentDisplay = 'inline' } = Astro.props;

const {
  image,
  content,
  duration,
  difficulty,
  tags = [],
  language,
  packages = [],
  tourtype,
  distance,
  reviews: initialReviews = [],
  isNewTour = false
} = data;

const durationDays = Number(duration) || 0;
// Only package tours are sold as stays, so only they carry a night count.
// A day tour spans at most two calendar days with no accommodation, and
// `durationDays - 1` would advertise a night that is not part of the trip.
const isMultiDay = tourtype === 'PackageTour';
// Day tours are all `duration: 1`, so the plural label is now reachable with a
// count of one — "1 Days" — on every locale. Nights follow the same rule for
// the shortest packages.
const dayUnit =
  durationDays === 1
    ? ('Tour.Info.Duration.Unit.Day' as const)
    : ('Tour.Info.Duration.Unit.Days' as const);
const nightUnit =
  durationDays === 2
    ? ('Tour.Info.Duration.Unit.Night' as const)
    : ('Tour.Info.Duration.Unit.Nights' as const);

const testimonials = (
  (await getCollection(
    'testimonials',
    (t) => t.data.language === language && t.data.relatedProduct === data.id
  )) ?? []
).map(MapTestimonialToReview);

const reviews = initialReviews.concat(testimonials);

const { average, count } = getAggregatedReviews(reviews);
const minPrice =
  packages.length > 0
    ? Math.min(...packages.map((p) => p.price?.price ?? 0))
    : 0;
const minPromoPrice =
  packages.length > 0
    ? Math.max(...packages.map((p) => p.price?.promo ?? 0))
    : 0;
const priceFormat = new Intl.NumberFormat(Languages[language].locale, {
  style: 'currency',
  currency: (packages.length > 0 ? packages[0].price?.currency : null) ?? 'EUR'
});
const tourTags = await getCollection(
  'tourTags',
  (t) => tags?.includes(t.data.id) && t.data.language === language
);
---

<div
  class="tour-card tour-card-filterable reveal-up intersect:opacity-100 intersect-once"
  data-tour-title={data.title?.toLowerCase() || ''}
  data-tour-region={data.region || ''}
  data-tour-rider-levels={data.riderLevels?.join(' ') || ''}
  data-tour-tags={data.tags?.join(' ') || ''}
  data-tour-bike-categories={data.bikeCategories?.join(' ') || ''}
>
  <Card href={getTourPath(data, language)} frame="light" radius="xl" {...data}>
    {
      image && (
        <div class="relative">
          <CardMedia {...image} />
          {isNewTour ? (
            <span class="absolute top-3 left-3 rounded-md bg-green-600 px-3 py-1 text-sm font-bold text-white uppercase shadow-lg dark:bg-green-500 dark:text-gray-900">
              {t('Tour.Badge.New', language)}
            </span>
          ) : null}
        </div>
      )
    }
    <CardContent display={contentDisplay} class="p-6 sm:max-xl:p-4">
      {
        /*
        Card text inherits `text-primary` (#296a3f) from <Card color="primary">,
        which is a white-background green: on the dark surface it measures
        2.74:1, under the 3:1 floor. The greys below were likewise declared
        light-only. Each colour here carries its dark counterpart — emerald-300
        matches the primary-on-dark pairing already used in timeline.astro.
      */
      }
      <h3
        class="font-oswald line-clamp-2 text-xl font-bold dark:text-emerald-300"
      >
        {data.title}
      </h3>
      <p class="line-clamp-5 text-lg/relaxed text-gray-600 dark:text-gray-300">
        {getMarkdownExcerpt(content ?? '', 300)}
      </p>

      <Stack spacing="medium" layout="vertical" class="w-full">
        {
          durationDays > 0 ? (
            <span class="flex gap-2 text-gray-600 dark:text-gray-300">
              <i
                class="icon-[ph--clock-countdown-light] h-5 w-5"
                aria-hidden="true"
              />{' '}
              {durationDays} {t(dayUnit, language)}
              {isMultiDay && durationDays > 1 ? (
                <>
                  {' / '}
                  {durationDays - 1} {t(nightUnit, language)}
                </>
              ) : null}
            </span>
          ) : null
        }
        {
          difficulty && difficulty > 0 && (
            <span class="flex gap-2 text-gray-600 dark:text-gray-300">
              {tourtype !== 'PackageTour' ? (
                <i
                  class="icon-[ph--person-simple-walk-light] h-5 w-5"
                  aria-hidden="true"
                />
              ) : (
                <i
                  class="icon-[ph--person-simple-bike-light] h-5 w-5"
                  aria-hidden="true"
                />
              )}
              {t('Tour.Info.Difficulty.Label', language)} : {difficulty}/5
            </span>
          )
        }
        {
          distance && distance > 0 ? (
            <div class="flex items-center gap-2 dark:text-emerald-300">
              <i
                class="icon-[ph--map-trifold-light] h-5 w-5"
                aria-hidden="true"
              />
              <span>
                {t('Tour.Info.Distance.Label', language)}: {distance} km
              </span>
            </div>
          ) : null
        }
        <div class="flex gap-3">
          <Rating rating={average} class="text-orange-500" />
          <span class="text-neutral-700 dark:text-neutral-300"
            >({count} {t('Tour.Info.Reviews.Unit', language)})</span
          >
        </div>
        <div class="flex w-full items-center justify-between pt-2">
          {
            minPrice > 0 || minPromoPrice > 0 ? (
              <Stack spacing="none" alignment="leading" layout="vertical">
                {minPromoPrice > 0 && (
                  <span class="text-sm text-gray-500 line-through dark:text-gray-400">
                    {priceFormat.format(minPrice)}
                  </span>
                )}
                <span class="text-xl font-bold dark:text-emerald-300">
                  {priceFormat.format(
                    minPromoPrice > 0 ? minPromoPrice : minPrice
                  )}
                </span>
              </Stack>
            ) : (
              <div />
            )
          }
          {
            data.wetravel?.guidedUuid || data.wetravel?.selfGuidedUuid ? (
              <WeTravelButton
                uuid={
                  (data.wetravel.guidedUuid ||
                    data.wetravel.selfGuidedUuid) as string
                }
                uid={data.wetravel.uid}
                label={t('Tour.Form.Button.Text', language)}
                class="z-20 h-10 w-fit px-4 py-2 text-sm font-medium"
              />
            ) : (
              <LinkButton
                href={getTourPath(data, language)}
                variant="default"
                class="z-20"
              >
                {t('Tour.Form.Button.Text', language)}
              </LinkButton>
            )
          }
        </div>
      </Stack>

      <Separator weight="thin" color="neutral" />

      {
        tourTags && tourTags.length > 0 && (
          <Stack spacing="small" alignment="center" class="flex-wrap">
            <i
              class="icon-[ph--bookmark-simple-light] h-5 w-5"
              aria-hidden="true"
            />
            {tourTags.map((t) => (
              <LinkButton
                variant="link"
                class="z-20"
                href={getTourTagPath(t, language)}
              >
                {t.data.name ?? t.data.title}
              </LinkButton>
            ))}
          </Stack>
        )
      }
    </CardContent>
  </Card>
</div>
