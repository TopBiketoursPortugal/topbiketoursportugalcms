---
import WeTravelButton from 'src/components/page-sections/wetravel-button/wetravel-button.astro';

/**
 * Tour sidebar booking widget.
 *
 * One "Book Now" button. When a tour offers BOTH a guided (fixed group
 * departures / calendar) and a self-guided WeTravel trip, a small segmented
 * Guided/Self-guided toggle swaps which pre-rendered button is visible — each
 * button keeps its own fixed `data-uuid`, so we never rely on WeTravel reading
 * a swapped attribute at click time. With a single UUID, no toggle is shown.
 */
type Props = {
  guidedUuid?: string | null;
  selfGuidedUuid?: string | null;
  uid?: string;
  label?: string;
  guidedLabel?: string;
  selfGuidedLabel?: string;
  buttonClass?: string;
};

const {
  guidedUuid,
  selfGuidedUuid,
  uid = '2317568',
  label = 'Book Now',
  guidedLabel = 'Guided',
  selfGuidedLabel = 'Self-guided',
  buttonClass
} = Astro.props;

const hasGuided = !!guidedUuid;
const hasSelf = !!selfGuidedUuid;
const both = hasGuided && hasSelf;
---

<div class="wetravel-booking flex w-full flex-col gap-3">
  {
    both ? (
      <div
        class="wt-toggle inline-flex w-full self-stretch rounded-md bg-slate-100 p-1 text-sm dark:bg-slate-700"
        role="tablist"
      >
        <button
          type="button"
          class="wt-seg is-active flex-1 rounded px-3 py-1.5 font-medium transition-colors"
          data-mode="guided"
          aria-pressed="true"
        >
          {guidedLabel}
        </button>
        <button
          type="button"
          class="wt-seg flex-1 rounded px-3 py-1.5 font-medium transition-colors"
          data-mode="self"
          aria-pressed="false"
        >
          {selfGuidedLabel}
        </button>
      </div>
    ) : null
  }

  {
    hasGuided ? (
      <div data-wt-pane="guided">
        <WeTravelButton uuid={guidedUuid!} uid={uid} label={label} class={buttonClass} />
      </div>
    ) : null
  }
  {
    hasSelf ? (
      <div data-wt-pane="self" hidden={both}>
        <WeTravelButton uuid={selfGuidedUuid!} uid={uid} label={label} class={buttonClass} />
      </div>
    ) : null
  }
</div>

<style>
  .wt-seg {
    color: var(--color-muted, #5d6b62);
  }
  .wt-seg.is-active {
    background-color: white;
    color: var(--color-heading, #18271f);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  :global(.dark) .wt-seg.is-active {
    background-color: rgb(15 23 42);
    color: white;
  }
</style>

<script>
  function initWeTravelToggles() {
    document.querySelectorAll('.wetravel-booking').forEach((root) => {
      if (root.hasAttribute('data-wt-init')) return;
      root.setAttribute('data-wt-init', 'true');

      const segs = root.querySelectorAll<HTMLButtonElement>('.wt-seg');
      segs.forEach((seg) => {
        seg.addEventListener('click', () => {
          const mode = seg.dataset.mode;
          segs.forEach((s) => {
            const active = s === seg;
            s.classList.toggle('is-active', active);
            s.setAttribute('aria-pressed', String(active));
          });
          root
            .querySelectorAll<HTMLElement>('[data-wt-pane]')
            .forEach((pane) => {
              (pane as HTMLElement).hidden = pane.dataset.wtPane !== mode;
            });
        });
      });
    });
  }

  initWeTravelToggles();
  document.addEventListener('astro:page-load', initWeTravelToggles);
</script>
