---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import type { ReviewSchema } from 'src/schemas/tours';
import { MapTestimonialToReview } from 'utils/map-testimonial-to-review';
import { getTourPath, sanitizeUrl } from 'utils/permalinks';

type Props = { items: CollectionEntry<'tours'>[]; language: LanguageCodes };

const { items, language } = Astro.props;

const testimonials = await getCollection(
  'testimonials',
  (t) => t.data.language === language
);

function getPackagePrice(
  promo: number | null | undefined,
  price: number | null | undefined
): number {
  if (promo && promo > 0) {
    return promo;
  }

  return price ?? 0;
}

// Generate the JSON-LD schema
const schema = {
  '@context': 'https://schema.org/',
  '@graph': items.map(({ data: tour }) => {
    const tourReviewsAndTestimonials = (tour.reviews ?? [])
      .concat(
        testimonials
          .filter((t) => t.data.relatedProduct === tour.id)
          .map(MapTestimonialToReview)
      )
      .filter((r) => r.rating > 0) satisfies ReviewSchema[];

    const ratings = tourReviewsAndTestimonials.map((r) => r.rating);
    const bestRating = Math.max(...ratings);
    const worstRating = Math.min(...ratings);
    const ratingValue =
      ratings.reduce(
        (accumulator, currentValue) => accumulator + currentValue,
        0
      ) / ratings.length;

    // console.log(tour.packages);

    const aggregateRating =
      ratings.length > 0
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              'ratingValue': Math.ceil(ratingValue),
              'reviewCount': ratings.length,
              bestRating,
              worstRating
            }
          }
        : {};

    const reviews =
      tourReviewsAndTestimonials.length > 0
        ? {
            review: tourReviewsAndTestimonials.map((review: any) => ({
              '@type': 'Review',
              'reviewRating': {
                '@type': 'Rating',
                'ratingValue': review.rating,
                bestRating,
                worstRating
              },
              'author': {
                '@type': 'Person',
                'name': `${review.author?.givenName}${
                  (review.author?.familyName ?? '' !== '')
                    ? ' ' + review.author?.familyName
                    : ''
                }`,
                'givenName': review.author?.givenName,
                'familyName': review.author?.familyName ?? '',
                'address': {
                  '@type': 'PostalAddress',
                  'addressCountry': review.author?.country
                }
              },
              'datePublished': review.publishDate,
              'reviewBody': review.content
            }))
          }
        : {};

    return {
      '@type': 'Product',
      'name': tour.title,
      'description': tour.description,
      'brand': {
        '@type': 'Brand',
        'name': 'Top Bike Tours Portugal'
      },
      ...aggregateRating,
      ...reviews,
      'offers': {
        '@type': 'AggregateOffer',
        'highPrice': Math.max(
          ...(tour.packages?.map((p) =>
            getPackagePrice(p.price.promo, p.price?.price)
          ) ?? [0])
        ),
        'lowPrice': Math.min(
          ...(tour.packages?.map((p) =>
            getPackagePrice(p.price.promo, p.price?.price)
          ) ?? [0])
        ),
        'offerCount': tour.packages?.length ?? 1,
        'offers': tour.packages?.map((p) => ({
          '@type': 'Offer',
          'name': p.title,
          'url': sanitizeUrl(Astro.site + getTourPath(tour, language)),
          'price': getPackagePrice(p.price.promo, p.price?.price),
          'priceCurrency': 'EUR'
        })),
        'priceCurrency': 'EUR',
        'availability': 'https://schema.org/InStock'
      }
    };
  })
};
---

<script
  is:inline
  async
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
