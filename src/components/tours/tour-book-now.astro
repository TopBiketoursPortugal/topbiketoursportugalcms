---
import WeTravelBooking from './wetravel-booking.astro';
import Linkbutton from '../linkbutton/linkbutton.astro';
import TourForm from './tour-form.astro';
import { t } from 'utils/i18n';
import type { InferEntrySchema } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';

/**
 * Tour "Book Now" call-to-action. WeTravel takes priority, then the
 * FareHarbor/Bokun deep-link, then the email enquiry form.
 *
 * variant:
 *  - 'panel'  (sidebar): full experience — falls back to the inline enquiry form.
 *  - 'inline' (after a pricing table): button-only — the no-booking-provider
 *    fallback links up to the sidebar form (#tour-booking) instead of repeating
 *    the whole form under every table.
 */
type Props = {
  tour: InferEntrySchema<'tours'>;
  language: LanguageCodes;
  variant?: 'panel' | 'inline' | 'column';
  buttonClass?: string;
};

const { tour, language, variant = 'panel', buttonClass } = Astro.props;
const { wetravel, feature } = tour;
const hasWetravel = !!(wetravel?.guidedUuid || wetravel?.selfGuidedUuid);
const bookLabel = t('Tour.Form.Button.Text', language);
---

{
  variant === 'panel' ? (
    <TourForm code={tour.code} title={tour.title}>
      {hasWetravel ? (
        <WeTravelBooking
          guidedUuid={wetravel?.guidedUuid}
          selfGuidedUuid={wetravel?.selfGuidedUuid}
          uid={wetravel?.uid}
          label={bookLabel}
          guidedLabel={t('Tour.Booking.Guided', language)}
          selfGuidedLabel={t('Tour.Booking.SelfGuided', language)}
          buttonClass={buttonClass}
        />
      ) : feature?.bokunLink ? (
        <Linkbutton href={feature.bokunLink} title={bookLabel} stretch class={buttonClass}>
          {bookLabel}
        </Linkbutton>
      ) : null}
    </TourForm>
  ) : hasWetravel ? (
    <WeTravelBooking
      guidedUuid={wetravel?.guidedUuid}
      selfGuidedUuid={wetravel?.selfGuidedUuid}
      uid={wetravel?.uid}
      label={bookLabel}
      guidedLabel={t('Tour.Booking.Guided', language)}
      selfGuidedLabel={t('Tour.Booking.SelfGuided', language)}
      buttonClass={buttonClass}
    />
  ) : feature?.bokunLink ? (
    <Linkbutton href={feature.bokunLink} title={bookLabel} stretch={variant !== 'column'} class={buttonClass}>
      {bookLabel}
    </Linkbutton>
  ) : (
    <Linkbutton href="#tour-booking" title={bookLabel} stretch={variant !== 'column'} class={buttonClass}>
      {bookLabel}
    </Linkbutton>
  )
}
