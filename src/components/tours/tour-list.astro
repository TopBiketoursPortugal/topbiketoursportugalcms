---
import type { CollectionEntry } from 'astro:content';
import Grid from '../grid/grid.astro';
import type { LanguageCodes } from 'src/schemas/language';
import type { CardContentProps } from '../card/CardContent.astro';
import Stack from '../stack/stack.astro';
import TourCard from './tour-card.astro';
import TourListSchema from './tour-list-schema.astro';

type Props = {
  language: LanguageCodes;
  items: CollectionEntry<'tours'>[];
  contentDisplay?: CardContentProps['display'];
};

const { items, contentDisplay = 'inline', language } = Astro.props;
---

<div data-tour-grid>
  <Stack class="border-solid p-6" layout="vertical">
    <Grid cols={3}>
      {
        items.map(({ data: tour }) => (
          <TourCard
            tour={tour}
            contentDisplay={contentDisplay}
            language={language}
          />
        ))
      }
    </Grid>
  </Stack>
</div>
<TourListSchema items={items} language={language} />

<style>
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    :global(.tour-card-anim:nth-child(3n + 2)) {
      transition-delay: 0.1s;
    }
    :global(.tour-card-anim:nth-child(3n + 3)) {
      transition-delay: 0.2s;
    }
  }
</style>
