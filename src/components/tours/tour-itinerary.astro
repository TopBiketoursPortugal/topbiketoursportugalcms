---
import Accordion from 'src/components/page-sections/accordion/accordion.astro';
import AccordionItem from 'src/components/page-sections/accordion/accordion-item.astro';
import Prose from 'src/components/building-blocks/typography/prose.astro';

type Props = {
  itinerary: {
    title: string;
    description?: string;
  }[];
};

const { itinerary = [] } = Astro.props;
---

<Accordion>
  {
    itinerary.map(({ title = '', description = '' }) => (
      <AccordionItem title={title} open={false}>
        <Prose markdown={description} />
      </AccordionItem>
    ))
  }
</Accordion>
