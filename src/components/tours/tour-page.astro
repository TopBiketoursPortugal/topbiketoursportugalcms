---
/** @jsxImportSource astro */

import TourForm from 'src/components/tours/tour-form.astro';
import TourPricing from 'src/components/tours/tour-pricing.astro';
import Languages from 'src/../data/languages.json';
import AllFaqs from 'src/../data/faqs.json';
import SiteData from 'src/../data/site.json';
import { getAggregatedReviews } from 'utils/reviews';
import TabItem from '../tabs/TabItem.astro';
import Tabs from '../tabs/Tabs.astro';
import { cn } from 'utils/cn';
import Tooltip from '../tooltip/tooltip.astro';
import Separator from '../separator/separator.astro';
import Rating from '../rating/rating.astro';
import Gallery from '../gallery/gallery.astro';
import Prose from '../typography/prose.astro';
import ResponsiveImage from '../responsive-image/ResponsiveImage.astro';
import type { VisuallyEditable } from 'src/types';
import { getCollection, type InferEntrySchema } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import TourFaqs from './tour-faqs.astro';
import TourRelated from './tour-related.astro';
import { t } from 'utils/i18n';
import TourItinerary from './tour-itinerary.astro';
import Heading from '../typography/heading.astro';
import Linkbutton from '../linkbutton/linkbutton.astro';
import type { ReviewSchema } from 'src/schemas/tours';
import { getAuthorName } from '@utils/get-author-name';
import ReviewItem from '@components/collection/review-item.astro';
import { getTourPath } from 'utils/permalinks';
import TourTagBadge from './tour-tag-badge.astro';
import RiderLevelBadge from './rider-level-badge.astro';
import BikeCategoryBadge from './bike-category-badge.astro';
import TourBikesGroup from './tour-bikes-group.astro';

type Props = { tour: InferEntrySchema<'tours'> } & VisuallyEditable;

const { tour } = Astro.props;

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const {
  packages = [],
  itinerary = [],
  faqs,
  reviews: initialReviews = [],
  relatedTours = [],
  mapUrl = '',
  image,
  feature
} = tour;

const testimonials = (
  (await getCollection(
    'testimonials',
    (t) => t.data.language === language && t.data.relatedProduct === tour.id
  )) ?? []
).map(
  (t) =>
    ({
      content: t.body ?? '',
      rating: t.data.score,
      title: t.data.title,
      author: {
        country: t.data.author.country ?? '',
        givenName: t.data.author.name ?? ''
      },
      source: {
        url: t.data.reviewSource,
        name:
          t.data.reviewSource?.indexOf('tripadvisor') !== -1
            ? 'TripAdvisor'
            : ''
      }
    }) satisfies ReviewSchema
);

const reviews = initialReviews.concat(testimonials);

const { average, count } = getAggregatedReviews(reviews);
const minPrice =
  packages.length > 0
    ? Math.min(...packages.map((p) => p.price?.price ?? 0))
    : 0;
const maxPrice =
  packages.length > 0
    ? Math.max(...packages.map((p) => p.price?.price ?? 0))
    : 0;
const minPromoPrice =
  packages.length > 0
    ? Math.max(...packages.map((p) => p.price?.promo ?? 0))
    : 0;
const priceFormat = new Intl.NumberFormat(Languages[language].locale, {
  style: 'currency',
  currency: (packages.length > 0 ? packages[0].price?.currency : null) ?? 'EUR'
});
const isPromotional = minPromoPrice > 0;
const tourTags = await getCollection(
  'tourTags',
  (t) => (tour.tags ?? []).includes(t.data.id) && t.data.language === language
);
const tourRiderLevels = await getCollection(
  'tourRiderLevels',
  (t) =>
    (tour.riderLevels ?? []).includes(t.data.id) && t.data.language === language
);
const tourBikeCategories = await getCollection(
  'bikeCategories',
  (c) =>
    (tour.bikeCategories ?? []).includes(c.data.id) &&
    c.data.language === language
);
const tourBikeCategoryIds = tourBikeCategories.map((c) => c.data.id);
const tourBikes = await getCollection(
  'bikes',
  (b) =>
    tourBikeCategoryIds.includes(b.data.category) &&
    b.data.language === language
);
const groupedTourBikes = tourBikeCategories
  .map((cat) => ({
    category: cat,
    items: tourBikes
      .filter((b) => b.data.category === cat.data.id)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  }))
  .filter((g) => g.items.length > 0);
const enableFaqs = true;
const cards_per_row = 3;
const slideWidthRaw = `(100% - ${(cards_per_row - 1) * 1.5}rem) / ${cards_per_row}`;

// FAQPage schema
const faqItems = faqs && faqs.length > 0 ? faqs : AllFaqs[language];
const faqPageSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': faqItems.map(
          (faq: { question: string; answer: string }) => ({
            '@type': 'Question',
            'name': faq.question,
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': faq.answer
            }
          })
        )
      }
    : null;

// Enhanced Product schema
const site = SiteData[language];
const baseUrl = Astro.site ?? site.site.url;
const tourUrl = `${baseUrl}${getTourPath(tour, language).replace(/^\//, '')}`;
const effectivePrice = minPromoPrice > 0 ? minPromoPrice : minPrice;

const productSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'additionalType': 'https://schema.org/TouristTrip',
  'name': tour.title,
  'url': tourUrl,
  'brand': {
    '@type': 'Brand',
    'name': 'Top Bike Tours Portugal'
  }
};

const schemaDescription = tour.description || tour.seo?.page_description || '';
if (schemaDescription) productSchema.description = schemaDescription;
if (image?.src) productSchema.image = image.src;

// TouristTrip itinerary as structured data
if (itinerary && itinerary.length > 0) {
  productSchema.itinerary = {
    '@type': 'ItemList',
    'numberOfItems': itinerary.length,
    'itemListElement': itinerary.map((day, idx) => {
      const item: Record<string, any> = {
        '@type': 'ListItem',
        'position': idx + 1,
        'name': day.title
      };
      if (day.description) item.description = day.description;
      if (day.location?.city || day.location?.region) {
        item.item = {
          '@type': 'Place',
          'name': day.location.city || day.location.region,
          'address': {
            '@type': 'PostalAddress',
            'addressCountry': day.location.country === 'es' ? 'ES' : 'PT',
            ...(day.location.region
              ? { addressRegion: day.location.region }
              : {}),
            ...(day.location.city ? { addressLocality: day.location.city } : {})
          }
        };
        if (day.location.lat && day.location.lng) {
          item.item.geo = {
            '@type': 'GeoCoordinates',
            'latitude': parseFloat(day.location.lat),
            'longitude': parseFloat(day.location.lng)
          };
        }
      }
      return item;
    })
  };
  if (tour.duration && tour.duration > 0) {
    productSchema.touristType = language === 'pt' ? 'Ciclista' : 'Cyclist';
  }
}

const offerCurrency =
  (packages.length > 0 ? packages[0].price?.currency : null) ?? 'EUR';

if (effectivePrice > 0) {
  productSchema.offers = {
    '@type': 'AggregateOffer',
    'lowPrice': minPromoPrice > 0 ? minPromoPrice : minPrice,
    'highPrice': maxPrice,
    'priceCurrency': offerCurrency,
    'offerCount': packages.length,
    'availability': 'https://schema.org/InStock',
    'hasMerchantReturnPolicy': {
      '@type': 'MerchantReturnPolicy',
      'applicableCountry': 'PT',
      'returnPolicyCategory':
        'https://schema.org/MerchantReturnFiniteReturnWindow',
      'merchantReturnDays': 14
    },
    'shippingDetails': {
      '@type': 'OfferShippingDetails',
      'shippingRate': {
        '@type': 'MonetaryAmount',
        'value': 0,
        'currency': offerCurrency
      },
      'shippingDestination': {
        '@type': 'DefinedRegion',
        'addressCountry': 'PT'
      }
    }
  };
}

if (count > 0 && average > 0) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    'ratingValue': average.toFixed(1),
    'reviewCount': count,
    'bestRating': 5,
    'worstRating': 1
  };
  productSchema.review = reviews
    .filter((r) => r.rating > 0)
    .slice(0, 5)
    .map((review) => ({
      '@type': 'Review',
      'reviewRating': {
        '@type': 'Rating',
        'ratingValue': review.rating,
        'bestRating': 5,
        'worstRating': 1
      },
      'author': {
        '@type': 'Person',
        'name': getAuthorName(review)
      },
      'reviewBody': review.content
    }));
}
---

<article>
  {
    image && (
      <div class="tour-hero relative overflow-hidden">
        <ResponsiveImage {...image} class="max-h-96 lg:max-h-112" />
        <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent" />
        <div class="absolute inset-x-0 bottom-0 p-6 lg:p-10">
          <h1 class="font-oswald text-3xl font-extrabold text-balance text-white drop-shadow-lg md:text-4xl lg:text-5xl">
            {tour.title}
          </h1>
          <div class="mt-3 flex flex-wrap items-center gap-4">
            {count > 0 && (
              <div class="flex items-center gap-2">
                <Rating rating={average} class="text-orange-400" />
                <span class="text-sm text-white/90">({count})</span>
              </div>
            )}
            {(minPrice > 0 || minPromoPrice > 0) && (
              <span class="rounded-lg bg-white/20 px-3 py-1 text-sm font-bold text-white backdrop-blur-sm">
                {t('Tour.Form.FromPrice', language)}{' '}
                {priceFormat.format(effectivePrice)}
              </span>
            )}
          </div>
        </div>
      </div>
    )
  }
  <div
    class="line-container mx-auto grid w-full max-w-full grid-cols-1 justify-between gap-10 scroll-smooth md:grid-cols-[3fr_minmax(min(200px,100%),1fr)]"
  >
    <nav
      aria-label={t('Tour.Nav.Label', language)}
      class="sticky top-34.25 z-40 max-w-full overflow-auto bg-white dark:bg-slate-950"
    >
      <Tabs>
        <TabItem
          href="#detail"
          text={t('Tour.Tab.Details', language)}
          selected
        />
        {
          mapUrl.length > 0 ? (
            <TabItem href="#map" text={t('Tour.Tab.Map', language)} />
          ) : null
        }
        {
          itinerary.length > 0 ? (
            <TabItem
              href="#itinerary"
              text={t('Tour.Tab.Itinerary', language)}
            />
          ) : null
        }
        {
          packages?.length > 0 ? (
            <TabItem href="#packages" text={t('Tour.Tab.Packages', language)} />
          ) : null
        }
        {
          groupedTourBikes.length > 0 ? (
            <TabItem href="#bikes" text={t('Tour.Tab.Bikes', language)} />
          ) : null
        }
        <TabItem href="#photos" text={t('Tour.Tab.Photos', language)} />

        <TabItem href="#reviews" text={t('Tour.Tab.Reviews', language)} />
        {
          enableFaqs ? (
            <TabItem href="#faqs" text={t('Tour.Tab.Faqs', language)} />
          ) : null
        }
      </Tabs>
    </nav>
    <aside
      aria-label={t('Tour.Sidebar.Label', language)}
      class="tour-sidebar intersect:opacity-100 intersect-once z-10 order-first md:row-span-4 mx-auto -mt-24 flex w-full max-w-full shrink flex-col items-start justify-start gap-6 self-baseline rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-lg md:order-0 md:col-auto dark:border-green-500 dark:bg-gray-800"
    >
      {
        minPrice > 0 || minPromoPrice > 0 ? (
          <div class="relative flex items-center gap-2">
            <i class="icon-[ph--tag-light] h-5 w-5" aria-hidden="true" />
            <span class="self-end text-sm text-gray-500 dark:text-gray-400">
              {t('Tour.Form.FromPrice', language)}
            </span>
            {minPrice > 0 ? (
              <span
                class={cn(
                  isPromotional
                    ? 'text-xl text-gray-400 tabular-nums line-through'
                    : 'text-3xl font-bold text-green-700 tabular-nums dark:text-green-400'
                )}
              >
                {priceFormat.format(minPrice)}
              </span>
            ) : null}
            {isPromotional && minPromoPrice > 0 ? (
              <span class="text-3xl font-bold text-green-700 tabular-nums dark:text-green-400">
                {priceFormat.format(minPromoPrice)}
              </span>
            ) : null}

            <div class="w-2 -translate-x-1">
              <Tooltip class="align-top">
                <i
                  slot="trigger"
                  class="icon-[ph--info-light] h-5 w-5"
                  aria-hidden="true"
                  title={t('Tour.Form.FromPrice.Info', language)}
                />
                <span slot="content">
                  {t('Tour.Form.FromPrice.Info', language)}
                </span>
              </Tooltip>
            </div>
          </div>
        ) : null
      }
      {minPrice > 0 || minPromoPrice > 0 ? <Separator /> : null}
      <strong>{t('Tour.Form.Title', language)}</strong>

      {
        feature?.bokunLink ? (
          <Linkbutton
            href={feature?.bokunLink}
            title={t('Tour.Form.Button.Text', language)}
          >
            {t('Tour.Form.Button.Text', language)}
          </Linkbutton>
        ) : (
          <TourForm code={tour.code} title={tour.title} />
        )
      }
      <div
        class="flex flex-col gap-2 border-t border-gray-100 pt-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400"
      >
        <span class="flex items-center gap-2">
          <i
            class="icon-[ph--shield-check-light] h-4 w-4 text-green-600 dark:text-green-400"
            aria-hidden="true"></i>
          {t('Tour.Sidebar.SecurePayment', language)}
        </span>
        <span class="flex items-center gap-2">
          <i
            class="icon-[ph--check-circle-light] h-4 w-4 text-green-600 dark:text-green-400"
            aria-hidden="true"></i>
          {t('Tour.Sidebar.InstantConfirmation', language)}
        </span>
      </div>
    </aside>
    <section
      id="detail"
      class="tour-section intersect:opacity-100 intersect-once col-end-2 mb-12 flex w-full scroll-mt-36 flex-col gap-4 lg:mb-16"
    >
      <div class="flex gap-3">
        <Rating rating={average} class="text-orange-500" />
        <span class="text-neutral-700 dark:text-neutral-300"
          >({count} {t('Tour.Info.Reviews.Unit', language)})</span
        >
      </div>
      <div>
        <ul
          aria-label={t('Tour.Info.Label', language)}
          class="center grid grid-cols-2 items-stretch justify-center gap-4 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            tour.duration ? (
              <li class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50">
                <i
                  class="icon-[ph--clock-countdown-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
                <span class="text-lg font-bold">
                  {tour.duration} {t('Tour.Info.Duration.Unit.Days', language)}
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  {(tour.duration ?? 0) - 1}{' '}
                  {t('Tour.Info.Duration.Unit.Nights', language)}
                </span>
              </li>
            ) : null
          }
          {
            (tour.groupSize?.min ?? 0) + (tour.groupSize?.max ?? 0) > 0 ? (
              <li class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50">
                <i
                  class="icon-[ph--users-three-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
                <span class="text-lg font-bold">
                  {tour.groupSize?.min ?? 0}-{tour.groupSize?.max ?? 0}
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  {t('Tour.Info.Group.Label', language)}
                </span>
              </li>
            ) : null
          }
          {
            tour.distance ? (
              <li class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50">
                <i
                  class="icon-[ph--map-trifold-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
                <span class="text-lg font-bold">{tour.distance} km</span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  {t('Tour.Info.Distance.Label', language)}
                </span>
              </li>
            ) : null
          }
          <li
            class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50"
          >
            {
              tour.tourtype !== 'PackageTour' ? (
                <i
                  class="icon-[ph--person-simple-walk-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
              ) : (
                <i
                  class="icon-[ph--person-simple-bike-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
              )
            }
            <span class="text-lg font-bold">{tour.difficulty}/5</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              {t('Tour.Info.Difficulty.Label', language)}
            </span>
          </li>
          <li
            class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50"
          >
            <i
              class="icon-[ph--airplane-light] h-6 w-6 text-green-600 dark:text-green-400"
              aria-hidden="true"></i>
            <span class="text-lg font-bold">
              {tour.closestAirport ?? 'Aeroporto Sá Carneiro'}
            </span>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              {t('Tour.Info.ClosestAirport.Label', language)}
            </span>
          </li>
          {
            tour.minAge ? (
              <li class="flex flex-col items-center gap-2 rounded-lg bg-gray-50 p-4 text-center dark:bg-gray-800/50">
                <i
                  class="icon-[ph--user-light] h-6 w-6 text-green-600 dark:text-green-400"
                  aria-hidden="true"
                />
                <span class="text-lg font-bold">{tour.minAge}</span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  {t('Tour.Info.MinAge.Label', language)}
                </span>
              </li>
            ) : null
          }
        </ul>
      </div>
      {
        (tourRiderLevels?.length > 0 ||
          tourTags?.length > 0 ||
          tourBikeCategories?.length > 0) && (
          <div class="flex flex-wrap gap-2">
            {tourRiderLevels.map((level) => (
              <RiderLevelBadge level={level} language={language} size="md" />
            ))}
            {tourTags.map((tag) => (
              <TourTagBadge tag={tag} language={language} size="md" />
            ))}
            {tourBikeCategories.map((cat) => (
              <BikeCategoryBadge category={cat} language={language} size="md" />
            ))}
          </div>
        )
      }
      <Separator />
      <Prose markdown={tour.content ?? ''} />
      <slot />
    </section>
    {
      mapUrl.length > 0 ? (
        <section
          id="map"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-4 lg:mb-16"
        >
          <Heading as="h2" class="mb-6">
            {t('Tour.Section.Map.Title', language)}
          </Heading>
          <div class="w-full select-none">
            <iframe
              title={`${t('Tour.Section.Map.Title', language)} - ${tour.title}`}
              src={mapUrl}
              width="100%"
              height="480"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        </section>
      ) : null
    }
    {
      itinerary.length > 0 ? (
        <section
          id="itinerary"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-4 lg:mb-16"
        >
          <Heading as="h2" class="mb-6">
            {t('Tour.Section.Itinerary.Title', language)}
          </Heading>
          <TourItinerary itinerary={itinerary} />
        </section>
      ) : null
    }
    {
      packages?.length > 0 ? (
        <section
          id="packages"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-10 lg:mb-16"
        >
          <Heading as="h2" class="mb-6">
            {t('Tour.Section.Packages.Title', language)}
          </Heading>

          <div class="col-span-full">
            <TourPricing language={language} packages={tour.packages} />

            <Prose
              markdown={tour.afterPricing ?? ''}
              class="col-span-full mt-8"
            />
          </div>
        </section>
      ) : null
    }
    {
      groupedTourBikes.length > 0 ? (
        <section
          id="bikes"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-6 lg:mb-16"
        >
          <Heading as="h2" class="mb-2">
            {t('Tour.Section.Bikes.Title', language)}
          </Heading>
          {groupedTourBikes.map((group) => (
            <TourBikesGroup
              category={group.category}
              bikes={group.items}
              language={language}
            />
          ))}
        </section>
      ) : null
    }
    <section
      id="photos"
      class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-4 lg:mb-16"
    >
      <Heading as="h2" class="mb-6"
        >{t('Tour.Section.Photos.Title', language)}</Heading
      >
      <Gallery images={tour.images ?? []} />
    </section>

    {
      enableFaqs ? (
        <section
          id="faqs"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-4 lg:mb-16"
        >
          <Heading as="h2" class="mb-6">
            {t('Tour.Section.Faq.Title', language)}
          </Heading>
          <TourFaqs faqs={faqs} language={language} />
        </section>
      ) : null
    }
    <section
      id="reviews"
      class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex scroll-mt-36 flex-col gap-4 lg:mb-16"
    >
      <Heading as="h2" class="mb-6"
        >{t('Tour.Section.Reviews.Title', language)}</Heading
      >
      {
        reviews.length > 0 ? (
          <>
            <div class="mb-4 flex items-center gap-4 rounded-lg bg-gray-50 p-4 dark:bg-gray-800/50">
              <Rating rating={average} class="text-lg text-orange-500" />
              <div>
                <span class="text-2xl font-bold">{average.toFixed(1)}</span>
                <span class="ml-2 text-sm text-gray-500 dark:text-gray-400">
                  {t('Tour.Reviews.AggregateLabel', language).replace(
                    '$1',
                    String(count)
                  )}
                </span>
              </div>
            </div>

            <div
              class="reviews-carousel-container relative max-w-full"
              style="box-sizing: border-box;"
            >
              <button
                class="nav-btn prev absolute top-1/2 -left-4 z-10 hidden -translate-y-1/2 rounded-full bg-white/80 p-2 shadow-md transition-opacity hover:bg-white focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:outline-none disabled:opacity-0 sm:-left-6 sm:block dark:bg-black/50 dark:hover:bg-black/80"
                aria-label="Previous slide"
              >
                <i class="icon-[ph--caret-left-bold] text-xl" />
              </button>
              <button
                class="nav-btn next absolute top-1/2 -right-4 z-10 hidden -translate-y-1/2 rounded-full bg-white/80 p-2 shadow-md transition-opacity hover:bg-white focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:outline-none disabled:opacity-0 sm:-right-6 sm:block dark:bg-black/50 dark:hover:bg-black/80"
                aria-label="Next slide"
              >
                <i class="icon-[ph--caret-right-bold] text-xl" />
              </button>

              <div
                class="scroll-container flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-6"
                style={{ '--desktop-slide-width': `calc(${slideWidthRaw})` }}
              >
                {reviews.map((review) => (
                  <div class="carousel-item shrink-0 snap-start first:pl-4 last:pr-4 sm:first:pl-0 sm:last:pr-0">
                    <ReviewItem
                      name={getAuthorName(review)}
                      country={review.author?.country}
                      content={review.content}
                      rating={review.rating}
                      expand_behavior="button"
                    />
                  </div>
                ))}
              </div>
            </div>
          </>
        ) : (
          <div>{t('Tour.Section.Reviews.Empty', language)}</div>
        )
      }
    </section>
    {
      relatedTours.length > 0 ? (
        <section
          id="related"
          class="tour-section intersect:opacity-100 intersect-once col-span-full mb-12 flex flex-col gap-4 lg:mb-16"
        >
          <Heading as="h2" class="mb-6">
            {t('Tour.Section.RelatedTours.Title', language)}
          </Heading>
          <TourRelated language={language} related={relatedTours} />
        </section>
      ) : null
    }
    {
      feature?.bokunLink ? (
        <script
          is:inline
          async
          defer
          type="text/javascript"
          src="https://fareharbor.com/embeds/api/v1/?autolightframe=yes"
        />
      ) : null
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(productSchema)}
    />
    {
      faqPageSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(faqPageSchema)}
        />
      )
    }
  </div>
</article>

<script>
  const initCarousel = () => {
    document
      .querySelectorAll('.reviews-carousel-container')
      .forEach((container) => {
        // Prevent double initialization
        if (container.hasAttribute('data-carousel-init')) return;
        container.setAttribute('data-carousel-init', 'true');

        const scrollContainer = container.querySelector('.scroll-container');
        const prevBtn = container.querySelector(
          '.prev'
        ) as HTMLButtonElement | null;
        const nextBtn = container.querySelector(
          '.next'
        ) as HTMLButtonElement | null;

        if (!scrollContainer || !prevBtn || !nextBtn) return;

        const scrollAmount = () => {
          // Approximate slide width: take first item width + gap (1.5rem = 24px)
          const item = scrollContainer.querySelector('.carousel-item');
          return item ? item.getBoundingClientRect().width + 24 : 300;
        };

        const updateButtons = () => {
          prevBtn.disabled = scrollContainer.scrollLeft <= 10;
          nextBtn.disabled =
            scrollContainer.scrollLeft >=
            scrollContainer.scrollWidth - scrollContainer.clientWidth - 10;
        };

        prevBtn.addEventListener('click', () => {
          scrollContainer.scrollBy({
            left: -scrollAmount(),
            behavior: 'smooth'
          });
        });

        nextBtn.addEventListener('click', () => {
          scrollContainer.scrollBy({
            left: scrollAmount(),
            behavior: 'smooth'
          });
        });

        scrollContainer.addEventListener('scroll', updateButtons);
        // Initial check
        updateButtons();
        // Wait for layout
        setTimeout(updateButtons, 100);
      });
  };

  // Initialize on page load and view transitions
  document.addEventListener('astro:page-load', initCarousel);
</script>

<style>
  .carousel-item {
    width: calc(100% - 2rem); /* Mobile: almost full width with some peek */
    view-timeline-name: --carousel-item;
    view-timeline-axis: inline;
    animation: linear scale-up both;
    animation-timeline: --carousel-item;
    animation-range: entry 0% contain 0% exit 0% exit 100%; /* Fallback */
    animation-range: entry 25% contain 25% exit 25% exit 75%; /* Refined range */
  }

  @keyframes scale-up {
    from {
      opacity: 0.5;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0.5;
      transform: scale(0.9);
    }
  }

  @media (min-width: 1024px) {
    .carousel-item {
      width: var(--desktop-slide-width);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .tour-section {
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    .tour-section[no-intersect] {
      opacity: 0;
      transform: translateY(1rem);
    }
    .tour-sidebar {
      transition:
        opacity 0.7s ease 0.2s,
        transform 0.7s ease 0.2s;
    }
    .tour-sidebar[no-intersect] {
      opacity: 0;
      transform: translateX(1.5rem);
    }
  }
</style>
