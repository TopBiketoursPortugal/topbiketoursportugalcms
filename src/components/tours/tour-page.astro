---
/** @jsxImportSource astro */

import TourForm from 'src/components/tours/tour-form.astro';
import TourPricing from 'src/components/tours/tour-pricing.astro';
import Languages from 'src/../data/languages.json';
import { getAggregatedReviews } from 'utils/reviews';
import TabItem from '../tabs/TabItem.astro';
import Tabs from '../tabs/Tabs.astro';
import { cn } from 'utils/cn';
import Tooltip from '../tooltip/tooltip.astro';
import Separator from '../separator/separator.astro';
import Rating from '../rating/rating.astro';
import Gallery from '../gallery/gallery.astro';
import Prose from '../typography/prose.astro';
import ResponsiveImage from '../responsive-image/ResponsiveImage.astro';
import type { VisuallyEditable } from 'src/types';
import { getCollection, type InferEntrySchema } from 'astro:content';
import type { LanguageCodes } from 'src/schemas/language';
import TourFaqs from './tour-faqs.astro';
import TourRelated from './tour-related.astro';
import { t } from 'utils/i18n';
import TourItinerary from './tour-itinerary.astro';
import Heading from '../typography/heading.astro';
import Linkbutton from '../linkbutton/linkbutton.astro';
import type { ReviewSchema } from 'src/schemas/tours';
import { getAuthorName } from '@utils/get-author-name';
import ReviewItem from '@components/collection/review-item.astro';

type Props = { tour: InferEntrySchema<'tours'> } & VisuallyEditable;

const { tour } = Astro.props;

const language = (Astro.currentLocale ?? 'en') as LanguageCodes;
const {
  packages = [],
  itinerary = [],
  faqs,
  reviews: initialReviews = [],
  relatedTours = [],
  mapUrl = '',
  image,
  feature
} = tour;

const testimonials = (
  (await getCollection(
    'testimonials',
    (t) => t.data.language === language && t.data.relatedProduct === tour.id
  )) ?? []
).map(
  (t) =>
    ({
      content: t.body ?? '',
      rating: t.data.score,
      title: t.data.title,
      author: {
        country: t.data.author.country ?? '',
        givenName: t.data.author.name ?? ''
      },
      source: {
        url: t.data.reviewSource,
        name:
          t.data.reviewSource?.indexOf('tripadvisor') !== -1
            ? 'TripAdvisor'
            : ''
      }
    }) satisfies ReviewSchema
);

const reviews = initialReviews.concat(testimonials);

const { average, count } = getAggregatedReviews(reviews);
const minPrice =
  packages.length > 0
    ? Math.min(...packages.map((p) => p.price?.price ?? 0))
    : 0;
const minPromoPrice =
  packages.length > 0
    ? Math.max(...packages.map((p) => p.price?.promo ?? 0))
    : 0;
const priceFormat = new Intl.NumberFormat(Languages[language].locale, {
  style: 'currency',
  currency: (packages.length > 0 ? packages[0].price?.currency : null) ?? 'EUR'
});
const isPromotional = minPromoPrice > 0;
const enableFaqs = true;
const cards_per_row = 3;
const slideWidthRaw = `(100% - ${(cards_per_row - 1) * 1.5}rem) / ${cards_per_row}`;
// mapa, itenerario, preço
---

{image && <ResponsiveImage {...image} class="max-h-72" />}
<div
  class="line-container mx-auto grid w-full grid-cols-1 justify-between gap-10 scroll-smooth sm:grid-cols-[3fr_minmax(min(200px,100%),1fr)]"
>
  <div class="sticky top-34.25 z-40 overflow-auto bg-white dark:bg-slate-950">
    <Tabs>
      <TabItem href="#detail" text={t('Tour.Tab.Details', language)} selected />
      {
        mapUrl.length > 0 ? (
          <TabItem href="#map" text={t('Tour.Tab.Map', language)} />
        ) : null
      }
      {
        itinerary.length > 0 ? (
          <TabItem href="#itinerary" text={t('Tour.Tab.Itinerary', language)} />
        ) : null
      }
      {
        packages?.length > 0 ? (
          <TabItem href="#packages" text={t('Tour.Tab.Packages', language)} />
        ) : null
      }
      <TabItem href="#photos" text={t('Tour.Tab.Photos', language)} />

      <TabItem href="#reviews" text={t('Tour.Tab.Reviews', language)} />
      {
        enableFaqs ? (
          <TabItem href="#faqs" text={t('Tour.Tab.Faqs', language)} />
        ) : null
      }
    </Tabs>
  </div>
  <section
    class="z-10 order-first row-span-4 mx-auto -mt-24 flex w-full shrink flex-col items-start justify-start gap-6 self-baseline rounded-lg bg-white p-4 shadow-lg sm:order-0 dark:bg-gray-800"
  >
    {
      minPrice > 0 || minPromoPrice > 0 ? (
        <div class="relative flex items-center gap-2">
          <i class="icon-[ph--tag-light] h-5 w-5" aria-hidden="true" />
          <span class="self-end text-sm text-gray-500 dark:text-gray-400">
            {t('Tour.Form.FromPrice', language)}
          </span>
          {minPrice > 0 ? (
            <span
              class={cn(
                isPromotional ? 'line-trough text-xl' : 'text-2xl font-bold'
              )}
            >
              {priceFormat.format(minPrice)}
            </span>
          ) : null}
          {isPromotional && minPromoPrice > 0 ? (
            <span class="font-bold">
              {isPromotional && priceFormat.format(minPromoPrice)}
            </span>
          ) : null}

          <div class="w-2 -translate-x-1">
            <Tooltip class="align-top">
              <i
                slot="trigger"
                class="icon-[ph--info-light] h-5 w-5"
                aria-hidden="true"
                title={t('Tour.Form.FromPrice.Info', language)}
              />
              <span slot="content">
                {t('Tour.Form.FromPrice.Info', language)}
              </span>
            </Tooltip>
          </div>
        </div>
      ) : null
    }
    {minPrice > 0 || minPromoPrice > 0 ? <Separator /> : null}
    <strong>{t('Tour.Form.Title', language)}</strong>

    {
      feature?.bokunLink ? (
        <Linkbutton
          href={feature?.bokunLink}
          title={t('Tour.Form.Button.Text', language)}
        >
          {t('Tour.Form.Button.Text', language)}
        </Linkbutton>
      ) : (
        <TourForm code={tour.code} title={tour.title} />
      )
    }
  </section>
  <section id="detail" class="col-end-2 mb-8 flex w-full flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
    <div class="flex gap-3">
      <Rating rating={average} class="text-orange-500" />
      <span class="text-neutral-700 dark:text-neutral-300"
        >({count} {t('Tour.Info.Reviews.Unit', language)})</span
      >
    </div>
    <div>
      <ul class="center grid grid-cols-1 items-center justify-center gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tour.duration ? (
            <li class="flex items-center gap-3">
              <i
                class="icon-[ph--clock-countdown-light] h-5 w-5"
                aria-hidden="true"
              />
              {tour.duration}
              {t('Tour.Info.Duration.Unit.Days', language)} /{' '}
              {(tour.duration ?? 0) - 1}
              {t('Tour.Info.Duration.Unit.Nights', language)}
            </li>
          ) : null
        }
        {
          (tour.groupSize?.min ?? 0) + (tour.groupSize?.max ?? 0) > 0 ? (
            <li class="flex items-center gap-3">
              <i
                class="icon-[ph--users-three-light] h-5 w-5"
                aria-hidden="true"
              />
              {t('Tour.Info.Group.Label', language)} :{' '}
              {tour.groupSize?.min ?? 0}-{tour.groupSize?.max ?? 0}
              {t('Tour.Info.Group.Unit', language)}
            </li>
          ) : null
        }
        {
          tour.distance ? (
            <li class="flex items-center gap-3">
              <i
                class="icon-[ph--map-trifold-light] h-5 w-5"
                aria-hidden="true"
              />
              {t('Tour.Info.Distance.Label', language)}: {tour.distance} km
            </li>
          ) : null
        }
        <li class="flex items-center gap-3">
          {
            tour.tourtype !== 'PackageTour' ? (
              <i
                class="icon-[ph--person-simple-walk-light] h-5 w-5"
                aria-hidden="true"
              />
            ) : (
              <i
                class="icon-[ph--person-simple-bike-light] h-5 w-5"
                aria-hidden="true"
              />
            )
          }
          {t('Tour.Info.Difficulty.Label', language)} : {tour.difficulty}/5
        </li>
        <li class="flex items-center gap-3">
          <i class="icon-[ph--airplane-light] h-5 w-5" aria-hidden="true"></i>
          {t('Tour.Info.ClosestAirport.Label', language)}:{' '}
          {tour.closestAirport ?? 'Aeroporto Sá Carneiro'}
        </li>
        {
          tour.minAge ? (
            <li class="flex items-center gap-3">
              <i class="icon-[ph--user-light] h-5 w-5" aria-hidden="true" />
              {t('Tour.Info.MinAge.Label', language)}: {tour.minAge}
            </li>
          ) : null
        }
      </ul>
    </div>
    <Separator />
    <Prose markdown={tour.content ?? ''} />
    <slot />
  </section>
  {
    mapUrl.length > 0 ? (
      <section id="map" class="col-span-full mb-8 flex flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
        <Heading as="h2" class="mb-6">
          {t('Tour.Section.Map.Title', language)}
        </Heading>
        <div class="w-full select-none">
          <iframe
            title="tour"
            src={mapUrl}
            width="100%"
            height="480"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </section>
    ) : null
  }
  {
    itinerary.length > 0 ? (
      <section id="itinerary" class="col-span-full mb-8 flex flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
        <Heading as="h2" class="mb-6">
          {t('Tour.Section.Itinerary.Title', language)}
        </Heading>
        <TourItinerary itinerary={itinerary} />
      </section>
    ) : null
  }
  {
    packages?.length > 0 ? (
      <section id="packages" class="col-span-full mb-8 flex flex-col gap-10 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
        <Heading as="h2" class="mb-6">
          {t('Tour.Section.Packages.Title', language)}
        </Heading>

        <div class="col-span-full">
          <TourPricing language={language} packages={tour.packages} />

          <Prose
            markdown={tour.afterPricing ?? ''}
            class="col-span-full mt-8"
          />
        </div>
      </section>
    ) : null
  }
  <section id="photos" class="col-span-full mb-8 flex flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
    <Heading as="h2" class="mb-6"
      >{t('Tour.Section.Photos.Title', language)}</Heading
    >
    <Gallery images={tour.images ?? []} />
  </section>

  {
    enableFaqs ? (
      <section id="faqs" class="col-span-full mb-8 flex flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
        <Heading as="h2" class="mb-6">
          {t('Tour.Section.Faq.Title', language)}
        </Heading>
        <TourFaqs faqs={faqs} language={language} />
      </section>
    ) : null
  }
  <section id="reviews" class="col-span-full mb-8 flex flex-col gap-4 scroll-mt-36 tour-section intersect:opacity-100 intersect-once">
    <Heading as="h2" class="mb-6"
      >{t('Tour.Section.Reviews.Title', language)}</Heading
    >
    {
      reviews.length > 0 ? (
    
      <div class="reviews-carousel-container relative max-w-full overflow-x-clip" style="box-sizing: border-box;">
        <button
          class="nav-btn prev absolute top-1/2 -left-4 z-10 hidden -translate-y-1/2 rounded-full bg-white/80 p-2 shadow-md transition-opacity hover:bg-white disabled:opacity-0 sm:-left-6 sm:block dark:bg-black/50 dark:hover:bg-black/80"
          aria-label="Previous slide"
        >
          <i class="icon-[ph--caret-left-bold] text-xl" />
        </button>
        <button
          class="nav-btn next absolute top-1/2 -right-4 z-10 hidden -translate-y-1/2 rounded-full bg-white/80 p-2 shadow-md transition-opacity hover:bg-white disabled:opacity-0 sm:-right-6 sm:block dark:bg-black/50 dark:hover:bg-black/80"
          aria-label="Next slide"
        >
          <i class="icon-[ph--caret-right-bold] text-xl" />
        </button>

        <div
          class="scroll-container flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-6"
          style={{ '--desktop-slide-width': `calc(${slideWidthRaw})` }}
        >
          {reviews.map((review) => (
            <div class="carousel-item shrink-0 snap-start first:pl-4 last:pr-4 sm:first:pl-0 sm:last:pr-0">
              <ReviewItem
                name={getAuthorName(review)}
                country={review.author?.country}
                content={review.content}
                rating={review.rating}
                expand_behavior="button"
              />
            </div>
          ))}
        </div>
      </div>

<script>
  const initCarousel = () => {
    document.querySelectorAll('.reviews-carousel-container').forEach((container) => {
      // Prevent double initialization
      if (container.hasAttribute('data-carousel-init')) return;
      container.setAttribute('data-carousel-init', 'true');

      const scrollContainer = container.querySelector('.scroll-container');
      const prevBtn = container.querySelector('.prev') as HTMLButtonElement | null;
      const nextBtn = container.querySelector('.next') as HTMLButtonElement | null;

      if (!scrollContainer || !prevBtn || !nextBtn) return;

      const scrollAmount = () => {
        // Approximate slide width: take first item width + gap (1.5rem = 24px)
        const item = scrollContainer.querySelector('.carousel-item');
        return item ? item.getBoundingClientRect().width + 24 : 300;
      };

      const updateButtons = () => {
        prevBtn.disabled = scrollContainer.scrollLeft <= 10;
        nextBtn.disabled =
          scrollContainer.scrollLeft >=
          scrollContainer.scrollWidth - scrollContainer.clientWidth - 10;
      };

      prevBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });

      scrollContainer.addEventListener('scroll', updateButtons);
      // Initial check
      updateButtons();
      // Wait for layout
      setTimeout(updateButtons, 100);
    });
  };

  // Initialize on page load and view transitions
  document.addEventListener('astro:page-load', initCarousel);
</script>

<style>
  .carousel-item {
    width: calc(100% - 2rem); /* Mobile: almost full width with some peek */
    view-timeline-name: --carousel-item;
    view-timeline-axis: inline;
    animation: linear scale-up both;
    animation-timeline: --carousel-item;
    animation-range: entry 0% contain 0% exit 0% exit 100%; /* Fallback */
    animation-range: entry 25% contain 25% exit 25% exit 75%; /* Refined range */
  }

  @keyframes scale-up {
    from {
      opacity: 0.5;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0.5;
      transform: scale(0.9);
    }
  }

  @media (min-width: 1024px) {
    .carousel-item {
      width: var(--desktop-slide-width);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .tour-section {
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .tour-section[no-intersect] {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
      ) : (
        <div>{t('Tour.Section.Reviews.Empty', language)}</div>
      )
    }
  </section>
  {
    relatedTours.length > 0 ? (
      <section id="related" class="col-span-full mb-8 flex flex-col gap-4 tour-section intersect:opacity-100 intersect-once">
        <Heading as="h2" class="mb-6">
          {t('Tour.Section.RelatedTours.Title', language)}
        </Heading>
        <TourRelated language={language} related={relatedTours} />
      </section>
    ) : null
  }
  {
    feature?.bokunLink ? (
      <script
        is:inline
        async
        defer
        type="text/javascript"
        src="https://fareharbor.com/embeds/api/v1/?autolightframe=yes"
      />
    ) : null
  }
</div>
