---
import { cn } from 'utils/cn';

type Props = astroHTML.JSX.AnchorHTMLAttributes & {
  text: string;
  selected?: boolean;
};

const { href, text, selected } = Astro.props;
const syle = cn(
  'px-3 py-3 text-center text-sm text-gray-700 hover:bg-gray-200 dark:text-gray-300 dark:hover:bg-gray-800 whitespace-nowrap md:flex-1 md:px-6 md:py-4 md:text-base',
  selected ? 'bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-800' : ''
);
---

<a href={href} class={syle} aria-selected={selected}>{text}</a>
